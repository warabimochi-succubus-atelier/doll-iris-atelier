@using DollIrisGenerator.Models
@using DollIrisGenerator.Services
@using DollIrisGenerator.Web.Services
@implements IDisposable

@*
    The left / right pair, drawn from the same SVG the desktop app exports (DollIrisGenerator.Core), so what is
    seen here is what the desktop app prints. Shown as an image: SVG inside <img> never runs scripts, whatever
    a hand-edited file contains. The image is a blob: URL (PreviewInterop); each one is released once the next
    is on screen.
*@

<figure class="preview @Class">
    @if (_url != null)
    {
        <img src="@_url" alt="@Alt" draggable="false" />
        @if (ShowItemMarkers && !SingleEye)
        {
            var layout = SvgExporter.PairLayoutMm(Design, PairSpacingMm, SvgExporter.PairPaddingMm);
            var marks = Markers(layout.LeftCx, layout.RightCx, layout.Cy);
            if (marks.Count > 0)
            {
                @* Over the picture with the same viewBox (mm), so the rings sit on the items; screen only *@
                <svg class="preview-markers" viewBox="0 0 @Num(layout.Width) @Num(layout.Height)" aria-hidden="true" focusable="false">
                    @foreach (var (m, x, y) in marks)
                    {
                        string kind = m.Hovered ? "hovered" : m.Kind == MarkedItemKind.Symbol ? "symbol" : "highlight";
                        double r = Math.Max(m.Radius, MinMarkerMm);
                        string label = m.Number.ToString(System.Globalization.CultureInfo.InvariantCulture);
                        double lx = x + r * 0.71, ly = y - r * 0.71;
                        <g class="marker @kind">
                            <circle class="marker-shadow" cx="@Num(x)" cy="@Num(y)" r="@Num(r)" />
                            <circle class="marker-ring" cx="@Num(x)" cy="@Num(y)" r="@Num(r)" />
                            <rect class="marker-label-bg" x="@Num(lx - 0.1)" y="@Num(ly - LabelMm)" width="@Num(LabelMm * 0.62 * label.Length + 0.2)" height="@Num(LabelMm)" rx="0.15" />
                            <text class="marker-label" x="@Num(lx)" y="@Num(ly - LabelMm * 0.18)" font-size="@Num(LabelMm)">@label</text>
                        </g>
                    }
                </svg>
            }
        }
    }
    else if (_error != null)
    {
        <figcaption class="field-error">プレビューを描けませんでした: @_error</figcaption>
    }
</figure>

@code {
    [Parameter, EditorRequired] public IrisParameters Design { get; set; } = default!;

    /// <summary>Changes whenever <see cref="Design"/> may have changed (it is edited in place).</summary>
    [Parameter] public int Version { get; set; }

    /// <summary>Left eye only (thumbnails) instead of the pair.</summary>
    [Parameter] public bool SingleEye { get; set; }

    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Rings round the ticked symbols / highlights and the one whose card is pointed at (<see cref="HoveredItemId"/>),
    /// with their numbers in the list (the pair view of the editor only).
    /// </summary>
    [Parameter] public bool ShowItemMarkers { get; set; }

    [Parameter] public string? HoveredItemId { get; set; }

    /// <summary>Smallest ring and the label height, in the picture's mm.</summary>
    private const double MinMarkerMm = 0.35, LabelMm = 0.75;

    private static string Num(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>Both eyes' markers in the picture's coordinates; the pointed-at one last, so it is drawn on top.</summary>
    private List<(ItemMarker Marker, double X, double Y)> Markers(double leftCx, double rightCx, double cy)
    {
        var list = new List<(ItemMarker, double, double)>();
        foreach (var (right, cx) in new[] { (false, leftCx), (true, rightCx) })
            foreach (var m in ItemMarkers.ForEye(Design, right, HoveredItemId))
                list.Add((m, cx + m.X, cy + m.Y));
        return list.OrderBy(t => t.Item1.Hovered).ToList();
    }

    private string? _url;
    private string? _previousUrl;
    private string? _error;
    private IrisParameters? _drawnDesign;
    private int _drawnVersion = -1;
    private bool _dirty;
    private bool _drawing;

    private string Alt => SingleEye ? $"{Design.Name} (左目)" : $"{Design.Name} の左右ペア";

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_drawnDesign, Design) && _drawnVersion == Version) return;
        _drawnDesign = Design;
        _drawnVersion = Version;

        // First picture right away; later ones through the loop below
        if (_url == null && _error == null)
        {
            Draw();
            return;
        }
        _dirty = true;
        if (!_drawing) _ = DrawLatestAsync();
    }

    /// <summary>
    /// While a slider is dragged the design changes faster than it can be drawn. Each pass first lets the browser
    /// deliver the input already waiting, then draws only the newest state, so the preview keeps up instead of
    /// replaying every step.
    /// </summary>
    private async Task DrawLatestAsync()
    {
        _drawing = true;
        try
        {
            while (_dirty)
            {
                _dirty = false;
                await Task.Delay(1);
                if (_dirty) continue;
                Draw();
                StateHasChanged();
            }
        }
        finally
        {
            _drawing = false;
        }
    }

    private void Draw()
    {
        try
        {
            string svg = SingleEye
                ? SvgExporter.GenerateSingleEyeSvg(Design, isRightEye: false)
                : SvgExporter.GeneratePairSvg(Design, includePrintGuides: false, pairSpacingMm: PairSpacingMm);
            Show(PreviewInterop.SvgUrl(svg));
            _error = null;
        }
        catch (Exception ex)
        {
            Show(null);
            _error = ex.Message;
        }
    }

    /// <summary>Shows <paramref name="url"/>; the one shown so far is released after the next render.</summary>
    private void Show(string? url)
    {
        if (_previousUrl != null) PreviewInterop.Revoke(_previousUrl);
        _previousUrl = _url;
        _url = url;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // The new image is in the page now, so the old URL is no longer needed
        if (_previousUrl == null) return;
        PreviewInterop.Revoke(_previousUrl);
        _previousUrl = null;
    }

    public void Dispose()
    {
        if (_previousUrl != null) PreviewInterop.Revoke(_previousUrl);
        if (_url != null) PreviewInterop.Revoke(_url);
        _previousUrl = _url = null;
    }

    /// <summary>Gap between the eyes: the desktop app's default 「ペア内左右の間隔」.</summary>
    private static double PairSpacingMm => new PrintSheetConfig().PairSpacingXMm;
}
