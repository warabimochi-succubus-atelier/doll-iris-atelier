@using DollIrisGenerator.Models
@using DollIrisGenerator.Services
@using DollIrisGenerator.Web.Services
@implements IDisposable

@*
    The left / right pair, drawn from the same SVG the desktop app exports (DollIrisGenerator.Core), so what is
    seen here is what the desktop app prints. Shown as an image: SVG inside <img> never runs scripts, whatever
    a hand-edited file contains. The image is a blob: URL (PreviewInterop); each one is released once the next
    is on screen.
*@

<figure class="preview @Class">
    @if (_url != null)
    {
        <img src="@_url" alt="@Alt" draggable="false" />
    }
    else if (_error != null)
    {
        <figcaption class="field-error">プレビューを描けませんでした: @_error</figcaption>
    }
</figure>

@code {
    [Parameter, EditorRequired] public IrisParameters Design { get; set; } = default!;

    /// <summary>Changes whenever <see cref="Design"/> may have changed (it is edited in place).</summary>
    [Parameter] public int Version { get; set; }

    /// <summary>Left eye only (thumbnails) instead of the pair.</summary>
    [Parameter] public bool SingleEye { get; set; }

    [Parameter] public string? Class { get; set; }

    private string? _url;
    private string? _previousUrl;
    private string? _error;
    private IrisParameters? _drawnDesign;
    private int _drawnVersion = -1;
    private bool _dirty;
    private bool _drawing;

    private string Alt => SingleEye ? $"{Design.Name} (左目)" : $"{Design.Name} の左右ペア";

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_drawnDesign, Design) && _drawnVersion == Version) return;
        _drawnDesign = Design;
        _drawnVersion = Version;

        // First picture right away; later ones through the loop below
        if (_url == null && _error == null)
        {
            Draw();
            return;
        }
        _dirty = true;
        if (!_drawing) _ = DrawLatestAsync();
    }

    /// <summary>
    /// While a slider is dragged the design changes faster than it can be drawn. Each pass first lets the browser
    /// deliver the input already waiting, then draws only the newest state, so the preview keeps up instead of
    /// replaying every step.
    /// </summary>
    private async Task DrawLatestAsync()
    {
        _drawing = true;
        try
        {
            while (_dirty)
            {
                _dirty = false;
                await Task.Delay(1);
                if (_dirty) continue;
                Draw();
                StateHasChanged();
            }
        }
        finally
        {
            _drawing = false;
        }
    }

    private void Draw()
    {
        try
        {
            string svg = SingleEye
                ? SvgExporter.GenerateSingleEyeSvg(Design, isRightEye: false)
                : SvgExporter.GeneratePairSvg(Design, includePrintGuides: false, pairSpacingMm: PairSpacingMm);
            Show(PreviewInterop.SvgUrl(svg));
            _error = null;
        }
        catch (Exception ex)
        {
            Show(null);
            _error = ex.Message;
        }
    }

    /// <summary>Shows <paramref name="url"/>; the one shown so far is released after the next render.</summary>
    private void Show(string? url)
    {
        if (_previousUrl != null) PreviewInterop.Revoke(_previousUrl);
        _previousUrl = _url;
        _url = url;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // The new image is in the page now, so the old URL is no longer needed
        if (_previousUrl == null) return;
        PreviewInterop.Revoke(_previousUrl);
        _previousUrl = null;
    }

    public void Dispose()
    {
        if (_previousUrl != null) PreviewInterop.Revoke(_previousUrl);
        if (_url != null) PreviewInterop.Revoke(_url);
        _previousUrl = _url = null;
    }

    /// <summary>Gap between the eyes: the desktop app's default 「ペア内左右の間隔」.</summary>
    private static double PairSpacingMm => new PrintSheetConfig().PairSpacingXMm;
}
