@inject DollIrisGenerator.Web.Services.BrowserApi Browser

@*
    「このアプリについて」: icon, name, version, author and links, like the desktop app's バージョン情報.
    A native <dialog> shown with showModal(), so Esc, the backdrop and 「閉じる」 all close it.
*@

<button type="button" class="icon-button" @onclick="OpenAsync" title="このアプリについて" aria-label="このアプリについて">
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5.5"/><circle class="dot" cx="12" cy="7.6" r="1.1"/></svg>
</button>

<dialog id="@DialogId" class="about-dialog" aria-labelledby="about-title">
    <div class="about-body">
        <img class="about-icon" src="icon-192.png" alt="" width="96" height="96" />
        <h2 id="about-title" class="about-name">@AppInfo.Name</h2>
        <p class="about-version">@AppInfo.VersionLabel</p>
        <p class="about-tagline">ドールアイの虹彩をデザインし、実寸で印刷する<br />ドールメイク用アトリエツール</p>

        <hr class="about-rule" />

        <p class="about-label">作者</p>
        <img class="about-logo" src="author-logo.jpg" alt="@AppInfo.Author" width="700" height="300" />
        <p class="about-author">@AppInfo.Author</p>

        <p class="about-license">
            ブラウザ版です。印刷（A4 PDF）はデスクトップ版で行います。<br />
            ロゴとアイコンを除き、<a href="@AppInfo.LicenseUrl" target="_blank" rel="noopener noreferrer">@AppInfo.License</a> で公開しています。<br />
            @AppInfo.Copyright
        </p>

        <div class="about-links">
            <a class="button-like" href="@AppInfo.RepositoryUrl" target="_blank" rel="noopener noreferrer">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path class="fill" d="M12 2.5a9.5 9.5 0 0 0-3 18.5c.48.09.65-.2.65-.46v-1.6c-2.64.57-3.2-1.27-3.2-1.27-.43-1.1-1.06-1.39-1.06-1.39-.86-.59.07-.58.07-.58.95.07 1.45.98 1.45.98.85 1.45 2.22 1.03 2.76.79.09-.61.33-1.03.6-1.27-2.1-.24-4.32-1.05-4.32-4.69 0-1.03.37-1.88.98-2.54-.1-.24-.43-1.21.09-2.51 0 0 .8-.26 2.6.97a9 9 0 0 1 4.74 0c1.8-1.23 2.6-.97 2.6-.97.52 1.3.19 2.27.09 2.51.61.66.98 1.51.98 2.54 0 3.65-2.22 4.45-4.34 4.68.34.3.65.88.65 1.78v2.64c0 .26.17.56.66.46A9.5 9.5 0 0 0 12 2.5z"/></svg>
                GitHub
            </a>
            <a class="button-like" href="@AppInfo.ManualUrl" target="_blank" rel="noopener noreferrer">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5z"/><path d="M5 19.5A1.5 1.5 0 0 0 6.5 21H19v-3"/></svg>
                マニュアル
            </a>
        </div>
    </div>
    <form method="dialog" class="about-footer">
        <button type="submit" class="primary" autofocus>閉じる</button>
    </form>
</dialog>

@code {
    private const string DialogId = "about-dialog";

    private Task OpenAsync() => Browser.ShowDialogAsync(DialogId);
}
