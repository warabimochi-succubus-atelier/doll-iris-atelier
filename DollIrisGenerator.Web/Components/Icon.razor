@*
    A line icon drawn in the text color (24 x 24, 1.8 stroke), so the buttons look the same on every OS instead of
    each one drawing its own emoji. Decorative: the button's text, title or aria-label says what it does.
    Parts with class "fill" are solid (dice pips, the dot of ⓘ, the GitHub mark).
*@

<svg class="icon @Class" viewBox="0 0 24 24" aria-hidden="true" focusable="false">@((MarkupString)Paths(Name))</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Extra classes (size etc.).</summary>
    [Parameter] public string? Class { get; set; }

    private static string Paths(string name) => name switch
    {
        "undo" => """<path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>""",
        "redo" => """<path d="m15 14 5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13"/>""",
        "dice" => """<rect x="3.5" y="3.5" width="17" height="17" rx="3.5"/><g class="fill"><circle cx="8.3" cy="8.3" r="1.5"/><circle cx="15.7" cy="8.3" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="8.3" cy="15.7" r="1.5"/><circle cx="15.7" cy="15.7" r="1.5"/></g>""",
        "star" => """<path d="M12 3.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 16.8l-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z"/>""",
        "plus" => """<path d="M12 5v14M5 12h14"/>""",
        "close" => """<path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/>""",
        "export" => """<path d="M12 15V4"/><path d="m7.5 8.5 4.5-4.5 4.5 4.5"/><path d="M5 14v4.5A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5V14"/>""",
        "import" => """<path d="M12 4v11"/><path d="m7.5 10.5 4.5 4.5 4.5-4.5"/><path d="M5 14v4.5A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5V14"/>""",
        "info" => """<circle cx="12" cy="12" r="9"/><path d="M12 11v5.5"/><circle class="fill" cx="12" cy="7.6" r="1.3"/>""",
        "book" => """<path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5z"/><path d="M5 19.5A1.5 1.5 0 0 0 6.5 21H19v-3"/>""",
        "github" => """<path class="fill" d="M12 2.5a9.5 9.5 0 0 0-3 18.5c.48.09.65-.2.65-.46v-1.6c-2.64.57-3.2-1.27-3.2-1.27-.43-1.1-1.06-1.39-1.06-1.39-.86-.59.07-.58.07-.58.95.07 1.45.98 1.45.98.85 1.45 2.22 1.03 2.76.79.09-.61.33-1.03.6-1.27-2.1-.24-4.32-1.05-4.32-4.69 0-1.03.37-1.88.98-2.54-.1-.24-.43-1.21.09-2.51 0 0 .8-.26 2.6.97a9 9 0 0 1 4.74 0c1.8-1.23 2.6-.97 2.6-.97.52 1.3.19 2.27.09 2.51.61.66.98 1.51.98 2.54 0 3.65-2.22 4.45-4.34 4.68.34.3.65.88.65 1.78v2.64c0 .26.17.56.66.46A9.5 9.5 0 0 0 12 2.5z"/>""",
        _ => throw new ArgumentException($"Unknown icon: {name}", nameof(name))
    };
}
