<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Command line tool of Doll Iris Atelier (SPECIFICATION.md 23): checks design JSON files and writes SVG, PNG and
    the A4 PDF with the same code as the desktop app (DollIrisGenerator.Rendering, which uses WPF), so it is
    Windows only like the app.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DollIrisGenerator.Cli</RootNamespace>
    <AssemblyName>DollIrisCli</AssemblyName>
    <!-- Keep in step with <Version> in DollIrisGenerator.csproj (VersionSyncTests checks it) -->
    <Version>0.17.0</Version>
    <Product>Doll Iris Atelier</Product>
    <Title>Doll Iris Atelier CLI</Title>
    <AssemblyTitle>Doll Iris Atelier CLI</AssemblyTitle>
    <Authors>わらびもちサキュバス工房</Authors>
    <Company>わらびもちサキュバス工房</Company>
    <Copyright>© 2026 わらびもちサキュバス工房</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DollIrisGenerator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- PNG / A4 PDF output shared with the app; brings Core and resvg.dll with it -->
    <ProjectReference Include="..\DollIrisGenerator.Rendering\DollIrisGenerator.Rendering.csproj" />
  </ItemGroup>

</Project>
