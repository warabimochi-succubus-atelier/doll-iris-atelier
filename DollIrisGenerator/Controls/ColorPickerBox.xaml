<UserControl x:Class="DollIrisGenerator.Controls.ColorPickerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="32" d:DesignWidth="180">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Color Preview & Click to open palette (gradient mode: shows / hides the gradient editor) -->
        <Button x:Name="ColorPreviewBtn" Grid.Column="0" Margin="2" Padding="0"
                Click="OnColorPreviewClick"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                ToolTip="クリックしてカラーパレットを開く"
                BorderThickness="1" BorderBrush="#555555" Cursor="Hand">
            <Border x:Name="ColorSwatch" Background="CornflowerBlue" CornerRadius="3"/>
        </Button>

        <!-- HEX Input Box (solid color) -->
        <TextBox x:Name="HexTextBox" Grid.Column="1" Margin="4,2,2,2"
                 VerticalContentAlignment="Center"
                 FontFamily="Consolas" FontSize="12"
                 TextChanged="OnHexTextChanged"
                 Background="#2D3139" Foreground="#E0E6ED"
                 BorderBrush="#444A56" BorderThickness="1" Padding="4,0"/>

        <!-- Gradient preview bar (gradient mode, replaces the HEX box) -->
        <Border x:Name="GradientBar" Grid.Column="1" Margin="4,2,2,2" MinHeight="22" CornerRadius="3"
                BorderBrush="#444A56" BorderThickness="1" Visibility="Collapsed"
                ToolTip="グラデーションの色の並び (左端 0% → 右端 100%)"/>

        <!-- Solid / gradient switch (only where a gradient is allowed) -->
        <ComboBox x:Name="ModeCombo" Grid.Column="2" Margin="2" Width="104" FontSize="11"
                  VerticalContentAlignment="Center" Visibility="Collapsed"
                  SelectionChanged="OnModeChanged"
                  ToolTip="単色か、2色以上のグラデーションかを切り替えます">
            <ComboBoxItem Content="単色"/>
            <ComboBoxItem Content="グラデーション"/>
        </ComboBox>

        <!-- Gradient editor -->
        <Border x:Name="GradientEditor" Grid.Row="1" Grid.ColumnSpan="3" Margin="2,4,2,2" Padding="6"
                Background="#22262E" BorderBrush="#3A404D" BorderThickness="1" CornerRadius="4"
                Visibility="Collapsed">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="種類:" Foreground="#B0B8C5" FontSize="11" Width="40" VerticalAlignment="Center"/>
                    <Button x:Name="ReverseBtn" DockPanel.Dock="Right" Content="⇄ 反転" FontSize="11" Padding="6,1" Margin="4,0,0,0"
                            Click="OnReverseClick" ToolTip="色の並び (0% と 100%) を逆にします"/>
                    <ComboBox x:Name="KindCombo" FontSize="11" SelectionChanged="OnKindChanged">
                        <ComboBoxItem Content="線形 (直線方向)"/>
                        <ComboBoxItem Content="放射状 (中心から外へ)"/>
                    </ComboBox>
                </DockPanel>

                <DockPanel x:Name="AnglePanel" Margin="0,0,0,4">
                    <TextBlock Text="角度:" Foreground="#B0B8C5" FontSize="11" Width="40" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AngleValueTxt" DockPanel.Dock="Right" Text="90°" Foreground="#80D8FF" FontSize="11" Width="40"
                               TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider x:Name="AngleSlider" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15"
                            ValueChanged="OnAngleChanged" VerticalAlignment="Center"
                            ToolTip="0° = 左→右、90° = 上→下、180° = 右→左、270° = 下→上"/>
                </DockPanel>

                <TextBlock x:Name="RadialHint" Foreground="#8C95A6" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="0% が中心側、100% が外側の色です (外輪・放射ライン・ラメなどは帯の内側→外側)"/>

                <TextBlock Text="色と位置 (0% → 100%):" Foreground="#B0B8C5" FontSize="11" Margin="0,2,0,2"/>
                <StackPanel x:Name="StopsPanel"/>

                <Button x:Name="AddStopBtn" Content="＋ 色を追加" HorizontalAlignment="Left" FontSize="11" Padding="8,2" Margin="0,4,0,0"
                        Click="OnAddStopClick" ToolTip="色を1つ追加します (最大5色)"/>
            </StackPanel>
        </Border>

        <!-- Palette Popup -->
        <Popup x:Name="PalettePopup" StaysOpen="False" PlacementTarget="{Binding ElementName=ColorPreviewBtn}" Placement="Bottom">
            <Border Background="#252830" BorderBrush="#4A5260" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel Width="230">
                    <TextBlock Text="ドールアイ推奨パレット" Foreground="#B0B8C5" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="PaletteWrapPanel" ItemWidth="22" ItemHeight="22" Margin="0,0,0,8"/>

                    <TextBlock Text="基本パレット" Foreground="#B0B8C5" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                    <WrapPanel x:Name="PrimaryWrapPanel" ItemWidth="22" ItemHeight="22" Margin="0,0,0,8"/>

                    <Border BorderBrush="#3A404D" BorderThickness="0,1,0,0" Margin="0,4,0,8"/>

                    <!-- RGB Custom Sliders -->
                    <TextBlock Text="カスタム RGB 調整" Foreground="#B0B8C5" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>

                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="R" Foreground="#FF8A80" Width="14" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RValueTxt" Text="0" Foreground="#888888" Width="26" FontSize="10" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="RSlider" Minimum="0" Maximum="255" ValueChanged="OnRgbSliderChanged" Margin="4,0,0,0"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="G" Foreground="#B9F6CA" Width="14" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GValueTxt" Text="0" Foreground="#888888" Width="26" FontSize="10" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="GSlider" Minimum="0" Maximum="255" ValueChanged="OnRgbSliderChanged" Margin="4,0,0,0"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="B" Foreground="#80D8FF" Width="14" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BValueTxt" Text="0" Foreground="#888888" Width="26" FontSize="10" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="BSlider" Minimum="0" Maximum="255" ValueChanged="OnRgbSliderChanged" Margin="4,0,0,0"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
