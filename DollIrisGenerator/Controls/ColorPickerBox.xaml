<UserControl x:Class="DollIrisGenerator.Controls.ColorPickerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="32" d:DesignWidth="180">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Color Preview & Click to open palette -->
        <Button x:Name="ColorPreviewBtn" Grid.Column="0" Margin="2" Padding="0"
                Click="OnColorPreviewClick"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                ToolTip="クリックしてカラーパレットを開く"
                BorderThickness="1" BorderBrush="#555555" Cursor="Hand">
            <Border x:Name="ColorSwatch" Background="CornflowerBlue" CornerRadius="3"/>
        </Button>

        <!-- HEX Input Box -->
        <TextBox x:Name="HexTextBox" Grid.Column="1" Margin="4,2,2,2"
                 VerticalContentAlignment="Center"
                 FontFamily="Consolas" FontSize="12"
                 TextChanged="OnHexTextChanged"
                 Background="#2D3139" Foreground="#E0E6ED"
                 BorderBrush="#444A56" BorderThickness="1" Padding="4,0"/>

        <!-- Palette Popup -->
        <Popup x:Name="PalettePopup" StaysOpen="False" PlacementTarget="{Binding ElementName=ColorPreviewBtn}" Placement="Bottom">
            <Border Background="#252830" BorderBrush="#4A5260" BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel Width="230">
                    <TextBlock Text="ドールアイ推奨パレット" Foreground="#B0B8C5" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="PaletteWrapPanel" ItemWidth="22" ItemHeight="22" Margin="0,0,0,8"/>

                    <TextBlock Text="基本パレット" Foreground="#B0B8C5" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                    <WrapPanel x:Name="PrimaryWrapPanel" ItemWidth="22" ItemHeight="22" Margin="0,0,0,8"/>

                    <Border BorderBrush="#3A404D" BorderThickness="0,1,0,0" Margin="0,4,0,8"/>

                    <!-- RGB Custom Sliders -->
                    <TextBlock Text="カスタム RGB 調整" Foreground="#B0B8C5" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                    
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="R" Foreground="#FF8A80" Width="14" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RValueTxt" Text="0" Foreground="#888888" Width="26" FontSize="10" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="RSlider" Minimum="0" Maximum="255" ValueChanged="OnRgbSliderChanged" Margin="4,0,0,0"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="G" Foreground="#B9F6CA" Width="14" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GValueTxt" Text="0" Foreground="#888888" Width="26" FontSize="10" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="GSlider" Minimum="0" Maximum="255" ValueChanged="OnRgbSliderChanged" Margin="4,0,0,0"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="B" Foreground="#80D8FF" Width="14" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BValueTxt" Text="0" Foreground="#888888" Width="26" FontSize="10" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="BSlider" Minimum="0" Maximum="255" ValueChanged="OnRgbSliderChanged" Margin="4,0,0,0"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
