<Window x:Class="DollIrisGenerator.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DollIrisGenerator"
        Title="バージョン情報"
        Icon="/DollIrisGenerator;component/app.ico"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}">

    <Window.Resources>
        <Style x:Key="LinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#80D8FF"/>
            <Setter Property="TextDecorations" Value="None"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,3,14,3"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <!-- The author logo has a light background, so it sits on its own light card -->
        <Border Background="#FAFAFC" CornerRadius="8" Padding="6" Margin="0,0,0,16">
            <Image Stretch="Uniform" Height="190" RenderOptions.BitmapScalingMode="HighQuality"
                   ToolTip="{x:Static local:AppInfo.Author}">
                <Image.Source>
                    <BitmapImage UriSource="/DollIrisGenerator;component/AuthorLogo.png" DecodePixelWidth="960"/>
                </Image.Source>
            </Image>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Image Width="40" Height="40" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Source>
                    <BitmapImage UriSource="/DollIrisGenerator;component/IrisGenerationApp.png" DecodePixelWidth="120"/>
                </Image.Source>
            </Image>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Static local:AppInfo.Name}" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{x:Static local:AppInfo.VersionLabel}" Foreground="#80D8FF" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="作者" Style="{StaticResource LabelText}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static local:AppInfo.Author}" Style="{StaticResource ValueText}"/>

            <TextBlock Grid.Row="1" Text="マニュアル" Style="{StaticResource LabelText}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}">
                <Hyperlink Style="{StaticResource LinkStyle}" NavigateUri="{x:Static local:AppInfo.ManualUri}"
                           RequestNavigate="OnRequestNavigate" ToolTip="{x:Static local:AppInfo.ManualUrl}">USER_MANUAL.md (GitHub) を開く</Hyperlink>
            </TextBlock>

            <TextBlock Grid.Row="2" Text="GitHub" Style="{StaticResource LabelText}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}">
                <Hyperlink Style="{StaticResource LinkStyle}" NavigateUri="{x:Static local:AppInfo.RepositoryUri}"
                           RequestNavigate="OnRequestNavigate" ToolTip="{x:Static local:AppInfo.RepositoryUrl}">リポジトリ</Hyperlink>
                <Run Text="  ·  " Foreground="{StaticResource TextMuted}"/>
                <Hyperlink Style="{StaticResource LinkStyle}" NavigateUri="{x:Static local:AppInfo.IssuesUri}"
                           RequestNavigate="OnRequestNavigate" ToolTip="{x:Static local:AppInfo.IssuesUrl}">不具合の報告・要望 (Issues)</Hyperlink>
            </TextBlock>

            <TextBlock Grid.Row="3" Text="ライセンス" Style="{StaticResource LabelText}"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}">
                <Hyperlink Style="{StaticResource LinkStyle}" NavigateUri="{x:Static local:AppInfo.LicenseUri}"
                           RequestNavigate="OnRequestNavigate" ToolTip="{x:Static local:AppInfo.LicenseUrl}"><Run Text="{x:Static local:AppInfo.License}"/></Hyperlink>
            </TextBlock>

            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{x:Static local:AppInfo.Copyright}"
                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,10,0,0"/>
        </Grid>

        <Button Content="閉じる" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"
                Padding="20,5" Margin="0,16,0,0" Click="OnClose"/>
    </StackPanel>
</Window>
