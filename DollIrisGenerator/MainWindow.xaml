<Window x:Class="DollIrisGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DollIrisGenerator"
        xmlns:vm="clr-namespace:DollIrisGenerator.ViewModels"
        xmlns:models="clr-namespace:DollIrisGenerator.Models"
        xmlns:controls="clr-namespace:DollIrisGenerator.Controls"
        mc:Ignorable="d"
        Title="Doll Iris Atelier"
        Icon="app.ico"
        Height="880" Width="1440" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Die icon of 「属性ランダム生成」: the same figure as the browser version's randomize button
             (DollIrisGenerator.Web/Pages/Home.razor, 24x24 viewBox: rounded square + five pips). Drawn in the button's
             text color. x:Shared="False": each button gets its own copy. -->
        <Viewbox x:Key="RandomizeDieIcon" x:Shared="False" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
            <Canvas Width="24" Height="24">
                <Rectangle Canvas.Left="3.5" Canvas.Top="3.5" Width="17" Height="17" RadiusX="3.5" RadiusY="3.5" StrokeThickness="1.8"
                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <Path Data="M6.8,8.3 A1.5,1.5 0 1 1 9.8,8.3 A1.5,1.5 0 1 1 6.8,8.3 Z
                            M14.2,8.3 A1.5,1.5 0 1 1 17.2,8.3 A1.5,1.5 0 1 1 14.2,8.3 Z
                            M10.5,12 A1.5,1.5 0 1 1 13.5,12 A1.5,1.5 0 1 1 10.5,12 Z
                            M6.8,15.7 A1.5,1.5 0 1 1 9.8,15.7 A1.5,1.5 0 1 1 6.8,15.7 Z
                            M14.2,15.7 A1.5,1.5 0 1 1 17.2,15.7 A1.5,1.5 0 1 1 14.2,15.7 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Canvas>
        </Viewbox>

        <!-- 「🔒 ランダム生成で変えない」 next to a settings box title: that box's values survive 「属性ランダム生成」 -->
        <Style x:Key="RandomizeLockCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#E1BEE7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Thin vertical line between the button groups of the top toolbar -->
        <Style x:Key="ToolbarSeparator" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="6,2,10,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource BorderDark}"/>
        </Style>

        <!-- One row of the A4 sheet list; shared by the 「A4印刷・テンプレート」 tab and the 「履歴・お気に入り」 tab.
             No fixed width: the row follows the panel, so the ✕ button stays visible however narrow the panel gets
             (the lists use StretchingListBox, which turns off horizontal scrolling). -->
        <DataTemplate x:Key="SheetItemTemplate">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="数量:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding PairCount, UpdateSourceTrigger=PropertyChanged}" Width="45" TextAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="✕" Command="{Binding DataContext.RemoveSelectedSheetItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" ToolTip="この行をシートから削除"
                            Padding="6,2" Background="#4A2020" Foreground="#FF8A80" BorderThickness="0"/>
                </StackPanel>
                <TextBlock Text="{Binding Parameters.SizeMm, StringFormat='{}{0:F1}mm'}" Foreground="#80D8FF" VerticalAlignment="Center" Width="60"
                           DockPanel.Dock="Right"/>
                <TextBlock Text="{Binding Parameters.Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Parameters.Name}"/>
            </DockPanel>
        </DataTemplate>

        <!-- List whose rows are as wide as the list: no horizontal scroll bar, long names are trimmed instead -->
        <Style x:Key="StretchingListBox" TargetType="ListBox">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- 「計 N 行 / 数量合計 M セット」 for the A4 sheet list -->
        <Style x:Key="SheetTotalsText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#80D8FF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Text">
                <Setter.Value>
                    <MultiBinding StringFormat="{}計 {0} 行 / 数量合計 {1} セット">
                        <Binding Path="SheetRowCount"/>
                        <Binding Path="SheetTotalPairs"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Text boxes keep their own Ctrl+Z (text undo); everywhere else these drive design undo/redo -->
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>

    <!-- F1 (the built-in gesture of ApplicationCommands.Help) opens the manual on GitHub -->
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Help" Executed="OnHelpExecuted"/>
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main Workspace -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Top Header Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BgMedium}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="True">
                <!-- App Title & Icon -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <!-- The logo has a transparent background; decode at a small size instead of the full 1254px image -->
                    <Image Width="28" Height="28" Margin="0,0,10,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Source>
                            <BitmapImage UriSource="IrisGenerationApp.png" DecodePixelWidth="84"/>
                        </Image.Source>
                    </Image>
                    <TextBlock Text="{x:Static local:AppInfo.Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border Background="#1E3A5F" CornerRadius="4" Margin="8,0,0,0" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static local:AppInfo.VersionLabel}" FontSize="10" Foreground="#80D8FF" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Toolbar: edit history | make a design | keep it | export | about. Thin separators mark the groups.
                     (乱数シードの変更 is in the 基本 tab, next to the seed.) -->
                <!-- WrapPanel: buttons move to a second row instead of being cut off in a narrow window -->
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="↩ 元に戻す" Command="{Binding UndoCommand}"
                            Background="#333842" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}"
                            Padding="8,5" Margin="0,2,4,2" ToolTip="デザイン (色・形・模様・ハイライトなど) の変更を1つ前に戻す (Ctrl+Z)。A4シートの配置・余白・間隔は対象外です"/>

                    <Button Content="↪ やり直す" Command="{Binding RedoCommand}"
                            Background="#333842" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}"
                            Padding="8,5" Margin="0,2,0,2" ToolTip="元に戻したデザインの変更をやり直す (Ctrl+Y)。A4シートの配置・余白・間隔は対象外です"/>

                    <Border Style="{StaticResource ToolbarSeparator}"/>

                    <Button Content="🆕 新しいデザイン" Command="{Binding NewDesignCommand}"
                            Background="#333842" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}"
                            Padding="10,5" Margin="0,2,4,2" Cursor="Hand" ToolTip="選択中の枠のデザインを、起動時と同じ初期状態 (虹彩 10mm・正円・標準の配色) に置き換えます。デザインは増えません。前のデザインは ↩ 元に戻す (Ctrl+Z) で戻せます"/>

                    <Button Command="{Binding RandomizeAttributesCommand}" AutomationProperties.Name="属性ランダム生成"
                            Background="#3B2654" Foreground="#E1BEE7" BorderBrush="#BA68C8"
                            Padding="10,5" Margin="0,2,0,2" Cursor="Hand" FontWeight="SemiBold"
                            ToolTip="サイズ・形状・寸法と、各設定枠の「🔒 ランダム生成で変えない」でロックした項目を維持したまま、カラー・瞳孔・光彩・パターン等の属性値をランダム生成">
                        <StackPanel Orientation="Horizontal">
                            <StaticResource ResourceKey="RandomizeDieIcon"/>
                            <TextBlock Text="属性ランダム生成" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource ToolbarSeparator}"/>

                    <Button Content="⭐ お気に入りに追加" Command="{Binding AddFavoriteCommand}"
                            Background="#45381A" Foreground="#FFE082" BorderBrush="#FFB300"
                            Padding="10,5" Margin="0,2,4,2" Cursor="Hand" ToolTip="現在のデザインを「履歴・お気に入り」タブのお気に入り一覧に保存 (自動で保存されます)"/>

                    <Button Content="🖨️ A4シートに追加" Command="{Binding AddCurrentToSheetCommand}"
                            Background="#1E3A5F" Foreground="#80D8FF" BorderBrush="{StaticResource BorderDark}"
                            Padding="10,5" Margin="0,2,0,2" Cursor="Hand" ToolTip="現在のデザインをA4印刷シートの配置アイテムに1行追加"/>

                    <Border Style="{StaticResource ToolbarSeparator}"/>

                    <Button Content="🖼️ PNG 600 DPI" Command="{Binding ExportPng600Command}"
                            Background="#2B3A4A" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}"
                            Padding="10,5" Margin="0,2,4,2" Cursor="Hand" ToolTip="高解像度 600 DPI でPNG出力 (一般的な印刷・Web用)"/>

                    <Button Content="1200 DPI" Command="{Binding ExportPng1200Command}"
                            Background="#2B3A4A" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}"
                            Padding="10,5" Margin="0,2,8,2" Cursor="Hand" ToolTip="超高解像度 1200 DPI でPNG出力 (高精細印刷用・ファイルサイズ大)"/>

                    <!-- SVG is output only (for Illustrator / Inkscape etc.); it is always generated from the current parameters -->
                    <Button Content="💾 SVG 保存" Command="{Binding ExportSvgCommand}"
                            Background="#005B60" Foreground="#A7FFEB" BorderBrush="{StaticResource BorderDark}"
                            Padding="10,5" Margin="0,2,4,2" Cursor="Hand" ToolTip="現在のデザインを SVG ファイルとして保存 (Illustrator / Inkscape 等で編集できるベクターデータ)"/>

                    <Button Content="📋 SVG コピー" Command="{Binding CopySvgCommand}"
                            Background="#005B60" Foreground="#A7FFEB" BorderBrush="{StaticResource BorderDark}"
                            Padding="10,5" Margin="0,2,8,2" Cursor="Hand" ToolTip="現在のデザインの SVG コードをクリップボードにコピー (他のツールに直接貼り付けできます)"/>

                    <Button Content="📄 A4 PDF 出力" Command="{Binding ExportPdfCommand}"
                            Background="#00695C" Foreground="#FFFFFF" BorderBrush="#00897B"
                            FontWeight="Bold" Padding="12,5" Margin="0,2,0,2" Cursor="Hand" ToolTip="高精度 ±0.1mm A4印刷用PDFを出力"/>

                    <Border Style="{StaticResource ToolbarSeparator}"/>

                    <Button Content="ⓘ" Click="OnAboutClick" FontSize="14"
                            Background="#333842" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}"
                            Padding="9,3" Margin="0,2,0,2" Cursor="Hand"
                            ToolTip="バージョン情報 (作者・マニュアル・GitHub へのリンク)。F1 キーでマニュアルを開きます"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 2. Main Workspace Split: Preview (Left) & Inspector (Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>         <!-- Preview Area -->
                <ColumnDefinition Width="Auto"/>      <!-- Splitter -->
                <ColumnDefinition Width="520" MinWidth="440" MaxWidth="700"/> <!-- Controls Tabs -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Preview Canvas & View Tools -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- View Controls Bar -->
                    <RowDefinition Height="*"/>    <!-- Canvas -->
                </Grid.RowDefinitions>

                <!-- View Mode & Zoom Toolbar -->
                <Border Grid.Row="0" Background="{StaticResource BgLight}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,1" Padding="10,6">
                    <!-- Wraps to two rows when the preview area is narrow -->
                    <WrapPanel VerticalAlignment="Center">
                        <!-- Mode Radio Buttons -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                            <TextBlock Text="表示モード:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                            
                            <RadioButton Content="左右ペア" Margin="0,0,12,0"
                                         IsChecked="{Binding PreviewMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Pair}"/>
                            <RadioButton Content="A4シート" Margin="0,0,16,0"
                                         IsChecked="{Binding PreviewMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=A4Sheet}"/>
                        </StackPanel>

                        <!-- Split count of the pair preview (1-9 cells, each its own design) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2"
                                    IsEnabled="{Binding PreviewMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Pair}"
                                    ToolTip="左右ペア表示を最大 9 つの枠に分割し、複数のアイを並べて比較します。枠をクリックすると、そのアイが編集対象になります">
                            <TextBlock Text="分割:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                            <ComboBox ItemsSource="{x:Static vm:MainViewModel.CompareCountOptions}" SelectedItem="{Binding CompareCount}" Width="56"/>
                            <Button Content="⤢ 枠に合わせる" Click="OnFitCompareZoomClick" Height="26" Padding="6,0" Margin="6,0,0,0" Cursor="Hand"
                                    Background="#333842" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}"
                                    ToolTip="すべての枠のアイが枠内にちょうど収まる拡大率にし、表示位置も中央に戻します。分割数を増やしたときは、はみ出す場合だけ自動で縮小します"/>
                        </StackPanel>

                        <!-- Zoom & Guide Toggles -->
                        <WrapPanel VerticalAlignment="Center" Margin="0,2,0,2">
                            <Button Content="📏 実寸表示 (100% mm)" Command="{Binding ZoomRealSizeCommand}" Click="OnResetViewClick"
                                    Background="#3E4756" Foreground="#FFD54F" FontWeight="SemiBold"
                                    BorderThickness="1" BorderBrush="#5C6B73"
                                    Padding="8,4" Margin="0,0,8,0" Cursor="Hand"
                                    ToolTip="画面上で原寸大（18mm/20mm等）に正確に表示。定規やドールヘッドと直接比較できます。"/>

                            <Button Content="➕" Command="{Binding ZoomInCommand}" Width="28" Height="26" Margin="0,0,3,0" Background="#333842" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderDark}"/>
                            <Button Content="➖" Command="{Binding ZoomOutCommand}" Width="28" Height="26" Margin="0,0,3,0" Background="#333842" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderDark}"/>
                            <Button Content="リセット" Command="{Binding ZoomResetCommand}" Click="OnResetViewClick" ToolTip="拡大率と表示位置を元に戻す (プレビューのダブルクリックでも戻ります。A4シートは用紙の上端から表示します)" Height="26" Padding="6,0" Margin="0,0,12,0" Background="#333842" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}"/>

                            <CheckBox Content="カットライン" IsChecked="{Binding ShowCutLines}" Margin="0,0,8,0"/>
                            <CheckBox Content="センターマーク" IsChecked="{Binding ShowCenterMarks}"/>
                        </WrapPanel>
                    </WrapPanel>
                </Border>

                <!-- Interactive Preview Canvas (A4 sheet mode) -->
                <controls:IrisPreviewControl x:Name="PreviewCanvas" Grid.Row="1"
                                             Parameters="{Binding CurrentIris}"
                                             PreviewMode="A4Sheet"
                                             ZoomScale="{Binding SheetZoomScale}"
                                             ShowCutLines="{Binding ShowCutLines}"
                                             ShowCenterMarks="{Binding ShowCenterMarks}"
                                             SheetConfig="{Binding SheetConfig}"
                                             SheetItems="{Binding SheetItems}">
                    <controls:IrisPreviewControl.Style>
                        <Style TargetType="controls:IrisPreviewControl">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewMode}" Value="A4Sheet">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:IrisPreviewControl.Style>
                </controls:IrisPreviewControl>

                <!-- Pair mode: split into CompareCount cells; clicking a cell makes its design the one being edited -->
                <ItemsControl x:Name="CompareGrid" Grid.Row="1" ItemsSource="{Binding VisibleSlots}" Background="#1E2026">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewMode}" Value="A4Sheet">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding DataContext.CompareColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:CompareSlot}">
                            <Border Margin="1" BorderThickness="2" PreviewMouseDown="OnCompareCellMouseDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#3E4451"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsCompareSplit, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                    <Condition Binding="{Binding DataContext.IsCompareSplit, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="BorderBrush" Value="#FFD54F"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <controls:IrisPreviewControl Parameters="{Binding Iris}"
                                                                 PreviewMode="Pair"
                                                                 ShowEyeLabels="{Binding DataContext.IsCompareSplit, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"
                                                                 ZoomScale="{Binding DataContext.PairZoomScale, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                 ShowCutLines="{Binding DataContext.ShowCutLines, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                 ShowCenterMarks="{Binding DataContext.ShowCenterMarks, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                 SheetConfig="{Binding DataContext.SheetConfig, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    <!-- Cell number and design name (not hit-testable: clicks reach the preview) -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" Padding="6,2" CornerRadius="3"
                                            Background="#CC181A1F" IsHitTestVisible="False"
                                            Visibility="{Binding DataContext.IsCompareSplit, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFD54F"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding Number, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Iris.Name, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource BorderDark}"/>

            <!-- RIGHT: Parameter Tabs Inspector -->
            <Border Grid.Column="2" Background="{StaticResource BgMedium}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1,0,0,0">
                <TabControl Background="Transparent" BorderThickness="0" Margin="4">
                    <!-- Fixed two rows: 基本 / 色 / 瞳孔・放射線 / A4印刷 / 履歴 on top, the design detail tabs below (TabRowsPanel.Row="1").
                         The built-in TabPanel would move the selected row next to the content; this one keeps the rows in place. -->
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <controls:TabRowsPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,2" KeyboardNavigation.TabIndex="1"/>
                                <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" KeyboardNavigation.TabIndex="2">
                                    <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                    <!-- ======================================================== -->
                    <!-- TAB 1 (上段): 基本 (虹彩プリセット・名前・サイズ・形状・シード・ランダム生成) -->
                    <!-- ======================================================== -->
                    <TabItem Header="基本">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                            <StackPanel>
                                <!-- Iris presets: colors plus pupil, rays, sparkles, layers and symbol, so they sit here rather than in 色 -->
                                <GroupBox Header="虹彩プリセット・共有" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="プリセットを選んで、色・瞳孔・放射ライン・ラメ・ハイライトなどをまとめて適用:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding SelectedPreset.Description}" Foreground="#80D8FF" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                        <!-- Rename / remove: shown only for presets the user added (the built-in ones stay as they are),
                                             instead of a greyed-out row that is in view most of the time -->
                                        <DockPanel Margin="0,0,0,6"
                                                   Visibility="{Binding IsSelectedPresetUserMade, Converter={StaticResource BoolToVisConverter}}">
                                            <Button Content="🗑 削除" Command="{Binding RemovePresetCommand}" DockPanel.Dock="Right"
                                                    Background="#4A2430" Foreground="#FFCDD2" Padding="8,2" Margin="6,0,0,0" FontSize="11"
                                                    ToolTip="選択中の追加したプリセットを一覧から削除します (今のデザインは変わりません)"/>
                                            <Button Content="✏️ 名前を変更" Command="{Binding RenamePresetCommand}" DockPanel.Dock="Right"
                                                    Background="#333842" Foreground="{StaticResource TextSecondary}" Padding="8,2" Margin="6,0,0,0" FontSize="11"/>
                                            <TextBox Text="{Binding PresetNameDraft, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding RenamePresetCommand}"/>
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </DockPanel>

                                        <!-- Preset Sharing Actions -->
                                        <TextBlock Text="プリセット共有・管理:" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,4,0,4"/>
                                        <WrapPanel>
                                            <Button Content="➕ 現在のデザインをプリセット登録" Command="{Binding AddCurrentAsPresetCommand}"
                                                    Background="#1E3A5F" Foreground="#80D8FF" Padding="8,4" Margin="0,0,6,4" FontSize="11"
                                                    ToolTip="色・瞳孔・放射ライン・ラメ・外輪・オーロラ層・星雲・ハイライト・装飾記号・レンズ風をプリセットにします。サイズ・形状・傾き・シード・オッドアイは含みません"/>
                                            <Button Content="📤 プリセット書き出し" Command="{Binding ExportPresetsCommand}"
                                                    Background="#333842" Foreground="{StaticResource TextSecondary}" Padding="8,4" Margin="0,0,6,4" FontSize="11"/>
                                            <Button Content="📥 プリセット読み込み" Command="{Binding ImportPresetsCommand}"
                                                    Background="#333842" Foreground="{StaticResource TextSecondary}" Padding="8,4" Margin="0,0,0,4" FontSize="11"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Basic Parameters & Elliptical Settings -->
                                <GroupBox Header="基本設定・サイズ・楕円形状" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10" Padding="8">
                                    <StackPanel>
                                        <!-- Design Name -->
                                        <TextBlock Text="デザイン名:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding CurrentIris.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                        <!-- Size (mm) -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="虹彩サイズ (直径):" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CurrentIris.SizeMm, StringFormat='{}{0:F1} mm'}" Foreground="#80D8FF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <!-- Iris only (not the whole eye): 4-20 mm in 0.1 mm steps, same range as IrisParameters.MinSizeMm / MaxSizeMm -->
                                        <Slider Minimum="4.0" Maximum="20.0" Value="{Binding CurrentIris.SizeMm}" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                SmallChange="0.1" LargeChange="1.0" Margin="0,0,0,6"
                                                ToolTip="虹彩（黒目の色の部分）の直径です。アイ全体の直径ではありません。目安: 20mm のアイなら虹彩は約 10mm"/>

                                        <!-- Quick Size Presets (iris diameter) -->
                                        <WrapPanel Margin="0,0,0,10">
                                            <TextBlock Text="クイック選択: " Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <RadioButton Content="9mm" Margin="0,0,8,0" IsChecked="{Binding CurrentIris.SizeMm, Converter={StaticResource SizeMatchesConverter}, ConverterParameter=9.0}"/>
                                            <RadioButton Content="10mm" Margin="0,0,8,0" IsChecked="{Binding CurrentIris.SizeMm, Converter={StaticResource SizeMatchesConverter}, ConverterParameter=10.0}"/>
                                            <RadioButton Content="11mm" Margin="0,0,8,0" IsChecked="{Binding CurrentIris.SizeMm, Converter={StaticResource SizeMatchesConverter}, ConverterParameter=11.0}"/>
                                            <RadioButton Content="12mm" Margin="0,0,8,0" IsChecked="{Binding CurrentIris.SizeMm, Converter={StaticResource SizeMatchesConverter}, ConverterParameter=12.0}"/>
                                        </WrapPanel>

                                        <!-- Shape -->
                                        <TextBlock Text="虹彩形状 (正円・楕円対応):" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <RadioButton Content="正円" Margin="0,0,12,0" IsChecked="{Binding CurrentIris.Shape, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Circle}"/>
                                            <RadioButton Content="縦長楕円" Margin="0,0,12,0" IsChecked="{Binding CurrentIris.Shape, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=VerticalOval}"/>
                                            <RadioButton Content="横長楕円" Margin="0,0,12,0" IsChecked="{Binding CurrentIris.Shape, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=HorizontalOval}"/>
                                        </StackPanel>

                                        <!-- Aspect Ratio for Oval -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="楕円の縦横比率:" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                            <TextBlock Text="{Binding CurrentIris.AspectRatio, StringFormat='{}{0:F2}'}" Foreground="#80D8FF" HorizontalAlignment="Right" FontSize="11"/>
                                        </DockPanel>
                                        <Slider Minimum="0.6" Maximum="2.0" Value="{Binding CurrentIris.AspectRatio}" Margin="0,0,0,8"/>

                                        <!-- Tilt Angle (楕円傾き角度) -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="楕円の傾き角度 (チルト):" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                            <TextBlock Text="{Binding CurrentIris.TiltAngle, StringFormat='{}{0:F0}°'}" Foreground="#80D8FF" HorizontalAlignment="Right" FontSize="11"/>
                                        </DockPanel>
                                        <Slider Minimum="-45.0" Maximum="45.0" Value="{Binding CurrentIris.TiltAngle}" Margin="0,0,0,8"/>

                                        <!-- Seed -->
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock Text="乱数シード:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                            <Button Content="🎲 変更" Command="{Binding RandomizeSeedCommand}" DockPanel.Dock="Right" Padding="8,2" Margin="6,0,0,0" Background="#333842" Foreground="#80D8FF"/>
                                            <TextBox Text="{Binding CurrentIris.Seed, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Right"/>
                                        </DockPanel>

                                        <CheckBox Content="🔒 ランダム生成で変えない (乱数シード)" IsChecked="{Binding LockSeed}" Style="{StaticResource RandomizeLockCheckBox}"
                                                  HorizontalAlignment="Right" Margin="0,4,0,0"
                                                  ToolTip="乱数シード (放射模様の揺らぎやラメの散らばり方) をランダム生成で変えない"/>

                                        <!-- Randomize Attributes Button -->
                                        <Button Command="{Binding RandomizeAttributesCommand}" AutomationProperties.Name="属性ランダム生成 (サイズ・寸法維持)"
                                                Background="#3B2654" Foreground="#E1BEE7" BorderBrush="#BA68C8"
                                                Padding="10,6" Margin="0,10,0,0" Cursor="Hand" FontWeight="SemiBold" HorizontalAlignment="Stretch"
                                                ToolTip="サイズ・形状・寸法と、各設定枠の「🔒 ランダム生成で変えない」でロックした項目を維持したまま、カラー・瞳孔・光彩・パターン等の属性値をランダム生成">
                                            <StackPanel Orientation="Horizontal">
                                                <StaticResource ResourceKey="RandomizeDieIcon"/>
                                                <TextBlock Text="属性ランダム生成 (サイズ・寸法維持)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- What is locked right now: the lock check boxes sit in each settings box, spread over several tabs -->
                                        <Border Background="#241B30" BorderBrush="#5E3F75" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,6,0,0">
                                            <DockPanel>
                                                <Button Content="すべて解除" Command="{Binding ClearRandomizeLocksCommand}" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                        Padding="6,1" Margin="8,0,0,0" FontSize="10" Background="#333842" Foreground="{StaticResource TextSecondary}"
                                                        ToolTip="すべてのタブのロックをまとめて外す"/>
                                                <TextBlock Text="{Binding RandomizeLocksSummary}" Foreground="#E1BEE7" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                                                           ToolTip="ロックは各設定枠の見出しにある「🔒 ランダム生成で変えない」で切り替えます (シードは乱数シードの下)"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </GroupBox>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ======================================================== -->
                    <!-- TAB 2 (上段): 色 (虹彩カラー・オーロラ層・星雲) -->
                    <!-- ======================================================== -->
                    <TabItem Header="色">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                            <StackPanel>
                                <!-- Color Settings -->
                                <GroupBox Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10" Padding="8">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="虹彩カラー設定" VerticalAlignment="Center"/>
                                            <CheckBox Content="🔒 ランダム生成で変えない (すべての色)" IsChecked="{Binding LockColors}" Style="{StaticResource RandomizeLockCheckBox}"
                                                      ToolTip="この枠の色だけでなく、瞳孔・放射模様・外輪・ラメ・レンズ風・オッドアイ側を含むすべての色と、グラデーション範囲・反射光の強さ・オーロラ層・星雲・デザイン名をランダム生成で変えない"/>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <StackPanel>
                                        <!-- Base Color -->
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="ベース色 (中間色):" VerticalAlignment="Center" Width="120"/>
                                            <controls:ColorPickerBox SelectedColorHex="{Binding CurrentIris.BaseColor, Mode=TwoWay}"/>
                                        </DockPanel>

                                        <!-- Inner Color -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="内周色 (中心グラデ):" VerticalAlignment="Center" Width="120"/>
                                            <controls:ColorPickerBox SelectedColorHex="{Binding CurrentIris.InnerColor, Mode=TwoWay}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="内周グラデ範囲:" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Width="120"/>
                                            <Slider Value="{Binding CurrentIris.InnerGradientRadius}" Minimum="0.1" Maximum="0.9"/>
                                        </DockPanel>

                                        <!-- Outer Color -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="外周色 (外郭グラデ):" VerticalAlignment="Center" Width="120"/>
                                            <controls:ColorPickerBox SelectedColorHex="{Binding CurrentIris.OuterColor, Mode=TwoWay}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="外周グラデ範囲:" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Width="120"/>
                                            <Slider Value="{Binding CurrentIris.OuterGradientRadius}" Minimum="0.3" Maximum="1.2"/>
                                        </DockPanel>

                                        <!-- Lower Glow / Reflected Light -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="下部反射光 (照り返し):" VerticalAlignment="Center" Width="120"/>
                                            <controls:ColorPickerBox SelectedColorHex="{Binding CurrentIris.BottomHighlightColor, Mode=TwoWay}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="反射光の強さ:" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Width="120"/>
                                            <Slider Value="{Binding CurrentIris.BottomHighlightIntensity}" Minimum="0.0" Maximum="1.0"/>
                                        </DockPanel>

                                        <!-- Light direction (光の入る向き) -->
                                        <DockPanel Margin="0,8,0,4" ToolTip="虹彩のいちばん明るいところ (内周色) を、光の来る向きへずらします。強さ 0 でオフ。右目は「ハイライトも左右反転する」がオンのとき反転します">
                                            <TextBlock Text="光の強さ:" VerticalAlignment="Center" Width="120"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentIris.LightStrength, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding CurrentIris.LightStrength}" Minimum="0.0" Maximum="1.0"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,4" ToolTip="光の来る向き (画面上で 0° = 右、90° = 下、270° = 上)">
                                            <TextBlock Text="光の向き:" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Width="120"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentIris.LightAngle, StringFormat='{}{0:F0}°'}" FontSize="11" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding CurrentIris.LightAngle}" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15"/>
                                        </DockPanel>

                                        <!-- Aurora layer (オーロラ層) -->
                                        <DockPanel Margin="0,8,0,4" ToolTip="虹彩全体に重ねる色。グラデーションの「円周」にすると、中心の周りで色が移り変わるオーロラ風になります">
                                            <TextBlock Text="オーロラ層の色:" VerticalAlignment="Center" Width="120"/>
                                            <controls:ColorPickerBox AllowGradient="True" SelectedColorHex="{Binding CurrentIris.AuroraColor, Mode=TwoWay}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,4" ToolTip="0 でオフ">
                                            <TextBlock Text="オーロラ層の強さ:" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Width="120"/>
                                            <Slider Value="{Binding CurrentIris.AuroraOpacity}" Minimum="0.0" Maximum="1.0"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,2,0,4" ToolTip="通常: そのまま重ねる。スクリーン: 明るくなるだけ (発光)。覆い焼き: 強い発光。オーバーレイ: 明るいところをより明るく、暗いところをより暗く。ソフトライト: オーバーレイの弱いもの">
                                            <TextBlock Text="重ね方:" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Top" Margin="0,2,0,0" Width="120"/>
                                            <WrapPanel>
                                                <RadioButton Content="通常" Margin="0,0,8,2" IsChecked="{Binding CurrentIris.AuroraBlend, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Normal}"/>
                                                <RadioButton Content="スクリーン" Margin="0,0,8,2" IsChecked="{Binding CurrentIris.AuroraBlend, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Screen}"/>
                                                <RadioButton Content="覆い焼き" Margin="0,0,8,2" IsChecked="{Binding CurrentIris.AuroraBlend, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ColorDodge}"/>
                                                <RadioButton Content="オーバーレイ" Margin="0,0,8,2" IsChecked="{Binding CurrentIris.AuroraBlend, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Overlay}"/>
                                                <RadioButton Content="ソフトライト" Margin="0,0,8,2" IsChecked="{Binding CurrentIris.AuroraBlend, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SoftLight}"/>
                                            </WrapPanel>
                                        </DockPanel>

                                        <!-- Nebula layer (星雲) -->
                                        <DockPanel Margin="0,8,0,4" ToolTip="虹彩に重ねる雲のような模様の色。グラデーションにすると、虹彩の場所ごとに雲の色が変わります (銀河・星雲風)">
                                            <TextBlock Text="星雲の色:" VerticalAlignment="Center" Width="120"/>
                                            <controls:ColorPickerBox AllowGradient="True" SelectedColorHex="{Binding CurrentIris.NebulaColor, Mode=TwoWay}"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,4" ToolTip="0 でオフ">
                                            <TextBlock Text="星雲の強さ:" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Width="120"/>
                                            <Slider Value="{Binding CurrentIris.NebulaOpacity}" Minimum="0.0" Maximum="1.0"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,4" ToolTip="雲がどれだけ虹彩を覆うか">
                                            <TextBlock Text="星雲の量:" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Width="120"/>
                                            <Slider Value="{Binding CurrentIris.NebulaDensity}" Minimum="0.0" Maximum="1.0"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,4" ToolTip="大きいほど細かい雲になります">
                                            <TextBlock Text="星雲の細かさ:" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Width="120"/>
                                            <Slider Value="{Binding CurrentIris.NebulaScale}" Minimum="0.5" Maximum="3.0"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,4" ToolTip="雲を瞳孔のまわりで渦巻かせます。マイナスで逆回り (右目は自動で鏡像)">
                                            <TextBlock Text="星雲の渦巻き:" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Width="120"/>
                                            <Slider Value="{Binding CurrentIris.NebulaSwirl}" Minimum="-1.0" Maximum="1.0"/>
                                        </DockPanel>

                                        <!-- Fiber noise (繊維ノイズ) -->
                                        <DockPanel Margin="0,8,0,4" ToolTip="虹彩に、瞳孔から外へ伸びる細かい繊維のゆらぎを重ねます (明るい繊維と暗い繊維)。0 でオフ">
                                            <TextBlock Text="繊維ノイズ:" VerticalAlignment="Center" Width="120"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentIris.FiberNoise, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding CurrentIris.FiberNoise}" Minimum="0.0" Maximum="1.0"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,4" ToolTip="上げるほど繊維が細かく、密になります">
                                            <TextBlock Text="繊維の細かさ:" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Width="120"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentIris.FiberNoiseScale, StringFormat='{}{0:F2}'}" FontSize="11" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding CurrentIris.FiberNoiseScale}" Minimum="0.5" Maximum="2.0"/>
                                        </DockPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ======================================================== -->
                    <!-- TAB 3 (上段): 瞳孔 & 放射模様 -->
                    <!-- ======================================================== -->
                    <TabItem Header="瞳孔・放射線">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                            <StackPanel>
                                <!-- Pupil Parameters -->
                                <GroupBox Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10" Padding="8">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="瞳孔模様" VerticalAlignment="Center"/>
                                            <CheckBox Content="🔒 ランダム生成で変えない" IsChecked="{Binding LockPupil}" Style="{StaticResource RandomizeLockCheckBox}"
                                                      ToolTip="瞳孔の形・大きさ・透明度・ぼかし・宝石カット・色をランダム生成で変えない"/>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <StackPanel>
                                        <!-- Pupil Shape -->
                                        <TextBlock Text="瞳孔形状:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                        <WrapPanel Margin="0,0,0,8">
                                            <RadioButton Content="正円" Margin="0,0,10,4" IsChecked="{Binding CurrentIris.PupilShape, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Round}"/>
                                            <RadioButton Content="縦長楕円" Margin="0,0,10,4" IsChecked="{Binding CurrentIris.PupilShape, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=VerticalOval}"/>
                                            <RadioButton Content="猫目スリット" Margin="0,0,10,4" IsChecked="{Binding CurrentIris.PupilShape, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CatSlit}"/>
                                            <RadioButton Content="ハート型" Margin="0,0,10,4" IsChecked="{Binding CurrentIris.PupilShape, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Heart}"/>
                                            <RadioButton Content="星型" Margin="0,0,10,4" IsChecked="{Binding CurrentIris.PupilShape, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Star}"/>
                                        </WrapPanel>

                                        <!-- Pupil Size -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="瞳孔サイズ (直径比率):" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding CurrentIris.PupilSizeRatio, Converter={StaticResource DoubleToPercentConverter}}" Foreground="#80D8FF" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.10" Maximum="0.60" Value="{Binding CurrentIris.PupilSizeRatio}" Margin="0,0,0,8"/>

                                        <!-- Pupil Color -->
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="瞳孔色:" VerticalAlignment="Center" Width="110"/>
                                            <controls:ColorPickerBox AllowGradient="True" SelectedColorHex="{Binding CurrentIris.PupilColor, Mode=TwoWay}"/>
                                        </DockPanel>

                                        <!-- Pupil Opacity -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="透明度:" ToolTip="上げるほど透けます (0% で不透明、100% で見えない)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.PupilOpacity, Converter={StaticResource TransparencyPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CurrentIris.PupilOpacity, Converter={StaticResource OpacityToTransparencyConverter}}" Margin="0,0,0,6"/>

                                        <!-- Pupil Softness -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="輪郭の柔らかさ (ぼかし):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.PupilSoftness, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="0.30" Value="{Binding CurrentIris.PupilSoftness}" Margin="0,0,0,6"/>

                                        <!-- Pupil Corner Rounding -->
                                        <DockPanel Margin="0,0,0,4" ToolTip="猫目スリット・ハート型・星型の、とがった角を丸めます。0% で従来どおりのとがった形です。正円・縦長楕円には影響しません。">
                                            <TextBlock Text="角の丸み (猫目・ハート・星):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.PupilCornerRounding, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CurrentIris.PupilCornerRounding}" Margin="0,0,0,10"/>

                                        <!-- Gem cut (宝石カット) -->
                                        <DockPanel Margin="0,0,0,4" ToolTip="瞳孔の中に、宝石のカット面のような明暗の面を入れます。0% でオフ。ハート型・星型と組み合わせると宝石風になります">
                                            <TextBlock Text="宝石カット:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.PupilFacetIntensity, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CurrentIris.PupilFacetIntensity}" Margin="0,0,0,8"/>

                                        <DockPanel Margin="0,0,0,4" ToolTip="瞳孔のまわりを何面にカットするか">
                                            <TextBlock Text="カット面の数:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.PupilFacetCount, StringFormat='{}{0} 面'}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="4" Maximum="24" Value="{Binding CurrentIris.PupilFacetCount}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Radial Rays Parameters -->
                                <GroupBox Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10" Padding="8">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="放射模様" VerticalAlignment="Center"/>
                                            <CheckBox Content="🔒 ランダム生成で変えない" IsChecked="{Binding LockRays}" Style="{StaticResource RandomizeLockCheckBox}"
                                                      ToolTip="放射模様の本数・線幅・長さ・強度・ランダム性・内側半径・繊維の質感・色をランダム生成で変えない"/>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <StackPanel>
                                        <!-- Ray Count -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="ライン本数:" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding CurrentIris.RayCount, StringFormat='{}{0} 本'}" Foreground="#80D8FF" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="120" Value="{Binding CurrentIris.RayCount}" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                                        <!-- Ray Color -->
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="ライン色:" VerticalAlignment="Center" Width="110"/>
                                            <controls:ColorPickerBox AllowGradient="True" SelectedColorHex="{Binding CurrentIris.RayColor, Mode=TwoWay}"/>
                                        </DockPanel>

                                        <!-- Ray Thickness -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="線幅 (太さ):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.RayThickness, StringFormat='{}{0:F1}'}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.5" Maximum="4.0" Value="{Binding CurrentIris.RayThickness}" Margin="0,0,0,8"/>

                                        <!-- Ray Length -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="長さ比率:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.RayLengthRatio, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.30" Maximum="0.95" Value="{Binding CurrentIris.RayLengthRatio}" Margin="0,0,0,8"/>

                                        <!-- Ray Intensity -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="強度 (濃さ):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.RayIntensity, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CurrentIris.RayIntensity}" Margin="0,0,0,8"/>

                                        <!-- Ray Randomness -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="ランダム性 (変動量):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.RayRandomness, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CurrentIris.RayRandomness}" Margin="0,0,0,10"/>

                                        <!-- Fiber look (繊維の質感) -->
                                        <TextBlock Text="繊維の質感 (すべて 0 で直線)" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>

                                        <DockPanel Margin="0,0,0,4" ToolTip="瞳孔側を太く、先端を細く尖らせます">
                                            <TextBlock Text="先細り:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.RayTaper, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CurrentIris.RayTaper}" Margin="0,0,0,8"/>

                                        <DockPanel Margin="0,0,0,4" ToolTip="ラインごとに太さを変えます (最大で約 1/3 〜 2 倍)">
                                            <TextBlock Text="太さのばらつき:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.RayWidthVariation, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CurrentIris.RayWidthVariation}" Margin="0,0,0,8"/>

                                        <DockPanel Margin="0,0,0,4" ToolTip="ラインを渦巻き状に曲げます。マイナスで逆回り (右目は自動で鏡像)">
                                            <TextBlock Text="うねり (渦巻き):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.RayCurve, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="-1.0" Maximum="1.0" Value="{Binding CurrentIris.RayCurve}" Margin="0,0,0,8"/>

                                        <DockPanel Margin="0,0,0,4" ToolTip="メインのラインの間に細いラインを重ねて、繊維が密に見えるようにします">
                                            <TextBlock Text="細線レイヤー:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.RayFineLayer, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CurrentIris.RayFineLayer}"/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ======================================================== -->
                    <!-- TAB 4 (上段): A4印刷・面付け & PDFテンプレート (NEW!) -->
                    <!-- ======================================================== -->
                    <TabItem Header="A4印刷・テンプレート">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                            <StackPanel>
                                <!-- PDF Template Selection -->
                                <GroupBox Header="PDFテンプレート選択" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="ドールサイズや用途に合わせた専用レイアウトを適用:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding PdfTemplates}" SelectedItem="{Binding SelectedPdfTemplate}" DisplayMemberPath="Name" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedPdfTemplate.Description}" Foreground="#80D8FF" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <Button Content="↺ レイアウトをテンプレートの初期値に戻す" Command="{Binding ResetSheetConfigCommand}"
                                                ToolTip="面付け・余白・間隔・印刷補助マークを、選択中のテンプレートの初期値に戻します（配置アイテムはそのまま）"
                                                HorizontalAlignment="Left" Padding="10,4" Cursor="Hand"
                                                Background="#333842" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Sheet Item Management -->
                                <GroupBox Header="A4シート配置アイテム管理" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10" Padding="8">
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Content="➕ 現在のデザインをシートに追加" Command="{Binding AddCurrentToSheetCommand}"
                                                    Background="#1E3A5F" Foreground="#80D8FF" Padding="10,6" Margin="0,0,8,4" Cursor="Hand"/>
                                            <Button Content="⚡ A4を満杯に自動配置" Command="{Binding FillSheetWithCurrentCommand}"
                                                    Background="#2E4A3D" Foreground="#A7FFEB" Padding="10,6" Margin="0,0,8,4" Cursor="Hand"/>
                                            <Button Content="クリア" Command="{Binding ClearSheetCommand}"
                                                    Background="#333842" Foreground="{StaticResource TextSecondary}" Padding="8,6" Margin="0,0,0,4"/>
                                        </WrapPanel>

                                        <!-- Tall list (about 14 rows): the settings below can be reached by scrolling -->
                                        <ListBox ItemsSource="{Binding SheetItems}" SelectedItem="{Binding SelectedSheetItem}" ItemTemplate="{StaticResource SheetItemTemplate}"
                                                 Style="{StaticResource StretchingListBox}" controls:ScrollChaining.IsEnabled="True"
                                                 Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderDark}" Height="380" Margin="0,0,0,4"/>
                                        <TextBlock Style="{StaticResource SheetTotalsText}" HorizontalAlignment="Right" Margin="0,0,4,4"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Grid Imposition Settings -->
                                <GroupBox Header="面付け・レイアウト設定" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10" Padding="8">
                                    <StackPanel>
                                        <CheckBox Content="配置数をサイズと余白から自動計算する" IsChecked="{Binding SheetConfig.AutoCalculateGrid}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="手動列数:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                <Slider Minimum="1" Maximum="12" Value="{Binding SheetConfig.ManualColumns}" TickFrequency="1" IsSnapToTickEnabled="True"
                                                        IsEnabled="{Binding SheetConfig.AutoCalculateGrid, Converter={StaticResource InverseBoolConverter}}"/>
                                                <TextBlock Text="{Binding SheetConfig.ManualColumns, StringFormat='{}{0} 列'}" FontSize="11" HorizontalAlignment="Right" Foreground="#80D8FF"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="手動行数:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                <Slider Minimum="1" Maximum="20" Value="{Binding SheetConfig.ManualRows}" TickFrequency="1" IsSnapToTickEnabled="True"
                                                        IsEnabled="{Binding SheetConfig.AutoCalculateGrid, Converter={StaticResource InverseBoolConverter}}"/>
                                                <TextBlock Text="{Binding SheetConfig.ManualRows, StringFormat='{}{0} 行'}" FontSize="11" HorizontalAlignment="Right" Foreground="#80D8FF"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="間隔・余白設定 (mm):" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,4"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="ペア内左右の間隔 (mm):" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                <Slider Minimum="1.0" Maximum="10.0" Value="{Binding SheetConfig.PairSpacingXMm}"/>
                                                <TextBlock Text="{Binding SheetConfig.PairSpacingXMm, StringFormat='{}{0:F1} mm'}" FontSize="10" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="列間隔 (mm):" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                <Slider Minimum="2.0" Maximum="20.0" Value="{Binding SheetConfig.ColumnSpacingMm}"/>
                                                <TextBlock Text="{Binding SheetConfig.ColumnSpacingMm, StringFormat='{}{0:F1} mm'}" FontSize="10" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>

                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="行間隔 (mm):" FontSize="10" Foreground="{StaticResource TextMuted}" Width="100"/>
                                            <Slider Minimum="4.0" Maximum="20.0" Value="{Binding SheetConfig.RowSpacingMm}"/>
                                        </DockPanel>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                                                <TextBlock Text="用紙 上余白 (mm):" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                <Slider Minimum="5.0" Maximum="35.0" Value="{Binding SheetConfig.PageMarginTopMm}"/>
                                                <TextBlock Text="{Binding SheetConfig.PageMarginTopMm, StringFormat='{}{0:F1} mm'}" FontSize="10" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                                                <TextBlock Text="用紙 下余白 (mm):" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                <Slider Minimum="5.0" Maximum="35.0" Value="{Binding SheetConfig.PageMarginBottomMm}"/>
                                                <TextBlock Text="{Binding SheetConfig.PageMarginBottomMm, StringFormat='{}{0:F1} mm'}" FontSize="10" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0">
                                                <TextBlock Text="用紙 左余白 (mm):" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                <Slider Minimum="5.0" Maximum="35.0" Value="{Binding SheetConfig.PageMarginLeftMm}"/>
                                                <TextBlock Text="{Binding SheetConfig.PageMarginLeftMm, StringFormat='{}{0:F1} mm'}" FontSize="10" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2">
                                                <TextBlock Text="用紙 右余白 (mm):" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                <Slider Minimum="5.0" Maximum="35.0" Value="{Binding SheetConfig.PageMarginRightMm}"/>
                                                <TextBlock Text="{Binding SheetConfig.PageMarginRightMm, StringFormat='{}{0:F1} mm'}" FontSize="10" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Print Guides Group -->
                                <GroupBox Header="印刷補助マーク" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,14" Padding="8">
                                    <StackPanel>
                                        <CheckBox Content="✂ カットライン印刷 (円形切り抜き用破線)" IsChecked="{Binding SheetConfig.ShowCutLines}" Margin="0,0,0,4"/>
                                        <CheckBox Content="➕ センターマーク印刷 (レジン盛り・カボション芯出し用十字)" IsChecked="{Binding SheetConfig.ShowCenterMarks}" Margin="0,0,0,4"/>
                                        <CheckBox Content="📐 トリムガイド印刷 (用紙トンボ)" IsChecked="{Binding SheetConfig.ShowTrimGuides}" Margin="0,0,0,4"/>
                                        <CheckBox Content="📏 1cm スケール印刷 (実寸確認用・用紙下部)" IsChecked="{Binding SheetConfig.ShowScaleMark}" Margin="0,0,0,4"
                                                  ToolTip="印刷後に定規で測り、横・縦とも 10mm ちょうどなら等倍 (100%) で印刷されています"/>
                                        <CheckBox Content="🏷️ パターン名＆実寸表記印字 (例: 20.0mm [サファイア])" IsChecked="{Binding SheetConfig.ShowLabels}"/>
                                    </StackPanel>
                                </GroupBox>

                                <Button Content="📄 A4 印刷用 PDF を書き出す (±0.1mm高精度)"
                                        Command="{Binding ExportPdfCommand}"
                                        Height="44" Background="#00695C" Foreground="#FFFFFF"
                                        FontSize="14" FontWeight="Bold" BorderBrush="#00897B" BorderThickness="1"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ======================================================== -->
                    <!-- TAB 5 (上段): 履歴 & お気に入り管理 (NEW!) -->
                    <!-- ======================================================== -->
                    <TabItem Header="履歴・お気に入り">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>               <!-- Favorites header -->
                                <RowDefinition Height="Auto"/>               <!-- Favorites actions -->
                                <RowDefinition Height="3*" MinHeight="140"/> <!-- Favorites list -->
                                <RowDefinition Height="Auto"/>               <!-- Sheet header -->
                                <RowDefinition Height="2*" MinHeight="110"/> <!-- Sheet list -->
                                <RowDefinition Height="Auto"/>               <!-- History header -->
                                <RowDefinition Height="110"/>                <!-- History list (kept small) -->
                            </Grid.RowDefinitions>

                            <!-- Favorites Header (add new favorites with 「⭐ お気に入りに追加」 in the top toolbar) -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="⭐ お気に入り登録リスト" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📥 インポート" Command="{Binding ImportFavoritesCommand}" Padding="6,2" Margin="0,0,4,0" Background="#333842" Foreground="{StaticResource TextSecondary}" FontSize="10"
                                            ToolTip="お気に入りファイル (*.irisfav.json) またはデザイン単体の JSON ファイルを読み込んで一覧に追加"/>
                                    <Button Content="📤 エクスポート" Command="{Binding ExportFavoritesCommand}" Padding="6,2" Background="#333842" Foreground="{StaticResource TextSecondary}" FontSize="10"
                                            ToolTip="お気に入り一覧をファイル (*.irisfav.json) に書き出し"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Favorites Actions -->
                            <DockPanel Grid.Row="1" Margin="0,0,0,4">
                                <Button Command="{Binding AddFavoritesToSheetCommand}" CommandParameter="{Binding SelectedItems, ElementName=FavoritesList}"
                                        Padding="8,3" Background="#1E3A5F" Foreground="#80D8FF" FontSize="11" Cursor="Hand"
                                        ToolTip="選択中のお気に入りを下の A4シート配置アイテムに追加します。すでにシートにあるデザインは数量が +1 されます">
                                    <TextBlock>
                                        <Run Text="🖨️ 選択したお気に入りをA4シートに追加 ("/><Run Text="{Binding SelectedItems.Count, ElementName=FavoritesList, Mode=OneWay}"/><Run Text=" 件)"/>
                                    </TextBlock>
                                </Button>
                                <TextBlock Text="ダブルクリックで復元 / Ctrl・Shift+クリックで複数選択" Foreground="{StaticResource TextMuted}" FontSize="10"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>

                            <!-- Favorites List -->
                            <ListBox x:Name="FavoritesList" Grid.Row="2" ItemsSource="{Binding Favorites}" SelectedItem="{Binding SelectedFavorite}"
                                     SelectionMode="Extended" Style="{StaticResource StretchingListBox}"
                                     Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Transparent background so a double-click anywhere on the row restores it.
                                             Buttons and date are docked right first, so they stay visible and the name takes what is left. -->
                                        <DockPanel Margin="2" Background="Transparent">
                                            <DockPanel.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick"
                                                              Command="{Binding DataContext.LoadFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                            </DockPanel.InputBindings>
                                            <Border Width="16" Height="16" CornerRadius="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Parameters.BaseColor}"/>
                                                </Border.Background>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <Button Content="復元" Command="{Binding DataContext.LoadFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Padding="6,3" Margin="0,0,3,0" Background="#1E3A5F" Foreground="#80D8FF" FontSize="10"
                                                        ToolTip="このお気に入りを現在のデザインとして読み込み (行のダブルクリックでも同じ)"/>
                                                <Button Content="複製" Command="{Binding DataContext.DuplicateFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Padding="6,3" Margin="0,0,3,0" Background="#333842" Foreground="#FFE082" FontSize="10"
                                                        ToolTip="このお気に入りをコピーして、すぐ下に「〇〇 のコピー」として追加"/>
                                                <Button Content="✕" Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Padding="6,3" Background="#4A2020" Foreground="#FF8A80" BorderThickness="0" FontSize="10"
                                                        ToolTip="このお気に入りを削除"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:MM/dd HH:mm}'}" Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center" Width="62"
                                                       DockPanel.Dock="Right"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding Note}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- A4 Sheet Items (same list as the 「A4印刷・テンプレート」 tab), to see what was added -->
                            <DockPanel Grid.Row="3" Margin="0,0,0,4">
                                <TextBlock Text="🖨️ A4シート配置アイテム" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource SheetTotalsText}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ListBox Grid.Row="4" ItemsSource="{Binding SheetItems}" SelectedItem="{Binding SelectedSheetItem}" ItemTemplate="{StaticResource SheetItemTemplate}"
                                     Style="{StaticResource StretchingListBox}" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10"/>

                            <!-- History Header -->
                            <DockPanel Grid.Row="5" Margin="0,0,0,4">
                                <TextBlock Text="⏪ 生成履歴タイムライン" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                <Button Content="履歴クリア" Command="{Binding ClearHistoryCommand}" HorizontalAlignment="Right" Padding="6,2" Background="#333842" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                            </DockPanel>

                            <!-- History List -->
                            <ListBox Grid.Row="6" ItemsSource="{Binding HistoryItems}" Style="{StaticResource StretchingListBox}"
                                     Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderDark}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2">
                                            <Button Content="この状態に戻す" Command="{Binding DataContext.RestoreHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Padding="8,3" Background="#333842" Foreground="#80D8FF" FontSize="10"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" Width="60"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Details}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Details}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- ======================================================== -->
                    <!-- TAB 6 (下段): 外輪 & ラメ -->
                    <!-- ======================================================== -->
                    <TabItem Header="外輪・ラメ" controls:TabRowsPanel.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                            <StackPanel>
                                <!-- Limbal Ring -->
                                <GroupBox Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10" Padding="8">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="外輪" VerticalAlignment="Center"/>
                                            <CheckBox Content="🔒 ランダム生成で変えない" IsChecked="{Binding LockLimbalRing}" Style="{StaticResource RandomizeLockCheckBox}"
                                                      ToolTip="外輪の太さ・透明度・ぼかし・色をランダム生成で変えない"/>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="リング幅 (太さ):" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding CurrentIris.LimbalRingThickness, Converter={StaticResource DoubleToPercentConverter}}" Foreground="#80D8FF" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="0.22" Value="{Binding CurrentIris.LimbalRingThickness}" Margin="0,0,0,8"/>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="リング色:" VerticalAlignment="Center" Width="110"/>
                                            <controls:ColorPickerBox AllowGradient="True" SelectedColorHex="{Binding CurrentIris.LimbalRingColor, Mode=TwoWay}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="透明度:" ToolTip="上げるほど透けます (0% で不透明、100% で見えない)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.LimbalRingOpacity, Converter={StaticResource TransparencyPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CurrentIris.LimbalRingOpacity, Converter={StaticResource OpacityToTransparencyConverter}}" Margin="0,0,0,8"/>

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="境界の柔らかさ (ぼかし):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.LimbalRingSoftness, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="0.80" Value="{Binding CurrentIris.LimbalRingSoftness}"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Glitter / Particles -->
                                <GroupBox Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10" Padding="8">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="粒子模様・ラメ" VerticalAlignment="Center"/>
                                            <CheckBox Content="🔒 ランダム生成で変えない" IsChecked="{Binding LockParticles}" Style="{StaticResource RandomizeLockCheckBox}"
                                                      ToolTip="ラメの数・大きさ・透明度・分布範囲・光るラメ (にじみ・十字フレア)・色をランダム生成で変えない"/>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="粒子数量 (ラメ数):" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding CurrentIris.ParticleCount, StringFormat='{}{0} 個'}" Foreground="#80D8FF" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0" Maximum="250" Value="{Binding CurrentIris.ParticleCount}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="ラメ色:" VerticalAlignment="Center" Width="110"/>
                                            <controls:ColorPickerBox AllowGradient="True" SelectedColorHex="{Binding CurrentIris.ParticleColor, Mode=TwoWay}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="粒径 (最大サイズ):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.ParticleMaxSize, StringFormat='{}{0:F1}'}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.5" Maximum="5.0" Value="{Binding CurrentIris.ParticleMaxSize}" Margin="0,0,0,8"/>

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="透明度:" ToolTip="上げるほど透けます (0% で不透明、100% で見えない)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.ParticleOpacity, Converter={StaticResource TransparencyPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CurrentIris.ParticleOpacity, Converter={StaticResource OpacityToTransparencyConverter}}" Margin="0,0,0,8"/>

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="分布範囲 (外周比率):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.ParticleRadiusRatio, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.30" Maximum="0.95" Value="{Binding CurrentIris.ParticleRadiusRatio}" Margin="0,0,0,10"/>

                                        <!-- Glowing glitter (光るラメ) -->
                                        <TextBlock Text="光るラメ (0 でにじみ・フレアなし)" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>

                                        <DockPanel Margin="0,0,0,4" ToolTip="粒のまわりにふんわりした光をにじませます">
                                            <TextBlock Text="光のにじみ:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.ParticleGlow, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CurrentIris.ParticleGlow}" Margin="0,0,0,8"/>

                                        <DockPanel Margin="0,0,0,4" ToolTip="十字の光の筋をつける粒の割合">
                                            <TextBlock Text="十字フレアの割合:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.ParticleFlareRatio, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CurrentIris.ParticleFlareRatio}" Margin="0,0,0,8"/>

                                        <DockPanel Margin="0,0,0,4" ToolTip="十字フレアの長さ (粒の大きさの何倍か)">
                                            <TextBlock Text="フレアの長さ:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.ParticleFlareLength, StringFormat='{}{0:F1} 倍'}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="1.0" Maximum="8.0" Value="{Binding CurrentIris.ParticleFlareLength}"/>
                                        <DockPanel Margin="0,2,0,4" ToolTip="ラメ (光のにじみを含む) の重ね方。通常: そのまま重ねる。スクリーン: 明るくなるだけ (発光)。覆い焼き: 強い発光。オーバーレイ: 明るいところをより明るく、暗いところをより暗く。ソフトライト: オーバーレイの弱いもの">
                                            <TextBlock Text="重ね方:" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Top" Margin="0,2,0,0" Width="120"/>
                                            <WrapPanel>
                                                <RadioButton Content="通常" Margin="0,0,8,2" IsChecked="{Binding CurrentIris.GlitterBlend, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Normal}"/>
                                                <RadioButton Content="スクリーン" Margin="0,0,8,2" IsChecked="{Binding CurrentIris.GlitterBlend, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Screen}"/>
                                                <RadioButton Content="覆い焼き" Margin="0,0,8,2" IsChecked="{Binding CurrentIris.GlitterBlend, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ColorDodge}"/>
                                                <RadioButton Content="オーバーレイ" Margin="0,0,8,2" IsChecked="{Binding CurrentIris.GlitterBlend, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Overlay}"/>
                                                <RadioButton Content="ソフトライト" Margin="0,0,8,2" IsChecked="{Binding CurrentIris.GlitterBlend, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SoftLight}"/>
                                            </WrapPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ======================================================== -->
                    <!-- TAB 7 (下段): 装飾記号 (たくさん追加できるので専用タブ) -->
                    <!-- ======================================================== -->
                    <TabItem Header="記号" controls:TabRowsPanel.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                            <StackPanel>
                                <!-- Decorative Symbols -->
                                <GroupBox Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10" Padding="8">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="装飾記号" VerticalAlignment="Center"/>
                                            <CheckBox Content="🔒 ランダム生成で変えない" IsChecked="{Binding LockSymbols}" Style="{StaticResource RandomizeLockCheckBox}"
                                                      ToolTip="装飾記号の一覧をランダム生成で変えない"/>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="装飾記号一覧:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Content="➕ 装飾記号追加" Command="{Binding AddSymbolCommand}"
                                                    HorizontalAlignment="Right" Padding="8,4" Background="#1E3A5F" Foreground="#80D8FF" BorderBrush="{StaticResource BorderDark}"/>
                                        </DockPanel>

                                        <TextBlock Text="装飾記号はありません。「➕ 装飾記号追加」で追加できます。" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentIris.Symbols.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <ItemsControl ItemsSource="{Binding CurrentIris.Symbols}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource BgLight}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,6">
                                                                <CheckBox Content="装飾記号を表示する" IsChecked="{Binding Enabled}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                <Button Content="✕ 削除" Command="{Binding DataContext.RemoveSymbolCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" HorizontalAlignment="Right" Padding="6,2" Background="#4A2020" Foreground="#FF8A80" BorderThickness="0" FontSize="11"/>
                                                            </DockPanel>

                                                            <TextBlock Text="図形種類:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                                            <WrapPanel Margin="0,0,0,6">
                                                                <RadioButton Content="なし" Margin="0,0,8,4" IsChecked="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=None}"/>
                                                                <RadioButton Content="4芒星 (★)" Margin="0,0,8,4" IsChecked="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Star4}"/>
                                                                <RadioButton Content="5芒星" Margin="0,0,8,4" IsChecked="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Star5}"/>
                                                                <RadioButton Content="ハート (♥)" Margin="0,0,8,4" IsChecked="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Heart}"/>
                                                                <RadioButton Content="三日月 (🌙)" Margin="0,0,8,4" IsChecked="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Moon}"/>
                                                                <RadioButton Content="クロス (✝)" Margin="0,0,8,4" IsChecked="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Cross}"/>
                                                                <RadioButton Content="ダイヤ (◆)" Margin="0,0,8,4" IsChecked="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Diamond}"/>
                                                                <RadioButton Content="桜の花びら (🌸)" Margin="0,0,8,4" IsChecked="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SakuraPetal}"/>
                                                            </WrapPanel>

                                                            <DockPanel Margin="0,0,0,6">
                                                                <TextBlock Text="記号色:" VerticalAlignment="Center" Width="90"/>
                                                                <controls:ColorPickerBox AllowGradient="True" SelectedColorHex="{Binding Color, Mode=TwoWay}"/>
                                                            </DockPanel>

                                                            <DockPanel Margin="0,0,0,4">
                                                                <TextBlock Text="サイズ:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding Size, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                                            </DockPanel>
                                                            <Slider Minimum="0.05" Maximum="0.40" Value="{Binding Size}" Margin="0,0,0,6"/>

                                                            <!-- Same range as DecorativeSymbolItem.Count (1-12); 2 or more puts the copies in a ring round the position -->
                                                            <DockPanel Margin="0,0,0,4" ToolTip="同じ記号をいくつ並べるか。2 以上にすると、位置のまわりに円を描くように並びます">
                                                                <TextBlock Text="繰り返し数:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding Count, StringFormat='{}{0} 個'}" FontSize="11" HorizontalAlignment="Right"/>
                                                            </DockPanel>
                                                            <Slider Minimum="1" Maximum="12" Value="{Binding Count}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,6"/>

                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="位置 X (横):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                                    <Slider Minimum="-0.85" Maximum="0.85" Value="{Binding PositionX}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="位置 Y (縦):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                                    <Slider Minimum="-0.85" Maximum="0.85" Value="{Binding PositionY}"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <DockPanel Margin="0,0,0,4">
                                                                <TextBlock Text="回転角度:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding Rotation, StringFormat='{}{0:F0}°'}" FontSize="11" HorizontalAlignment="Right"/>
                                                            </DockPanel>
                                                            <Slider Minimum="-180" Maximum="180" Value="{Binding Rotation}" Margin="0,0,0,6"/>

                                                            <DockPanel Margin="0,0,0,4" ToolTip="星の先・ハートの先・三日月の角など、図形のとがった部分を丸めます。0% で従来どおりのとがった形です。">
                                                                <TextBlock Text="角の丸み:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding CornerRounding, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                                            </DockPanel>
                                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CornerRounding}" Margin="0,0,0,6"/>

                                                            <DockPanel Margin="0,0,0,4">
                                                                <TextBlock Text="透明度:" ToolTip="上げるほど透けます (0% で不透明、100% で見えない)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding Opacity, Converter={StaticResource TransparencyPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                                            </DockPanel>
                                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding Opacity, Converter={StaticResource OpacityToTransparencyConverter}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ======================================================== -->
                    <!-- TAB 8 (下段): レンズ風パターン & オッドアイ (NEW!) -->
                    <!-- ======================================================== -->
                    <TabItem Header="レンズ風・オッドアイ" controls:TabRowsPanel.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                            <StackPanel>
                                <!-- Lens-Style Optical Pattern -->
                                <GroupBox Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10" Padding="8">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="レンズ風パターン" VerticalAlignment="Center"/>
                                            <CheckBox Content="🔒 ランダム生成で変えない" IsChecked="{Binding LockLens}" Style="{StaticResource RandomizeLockCheckBox}"
                                                      ToolTip="レンズ風パターンのオン／オフと各設定・色をランダム生成で変えない"/>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <StackPanel>
                                        <CheckBox Content="光学レンズ・フレネル屈折リングを有効化" IsChecked="{Binding CurrentIris.LensPatternEnabled}" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <TextBlock Text="カメラレンズや同心円フレネル溝のような屈折模様を虹彩内部に合成します:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="屈折リング数:" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding CurrentIris.LensRingCount, StringFormat='{}{0} 本'}" Foreground="#80D8FF" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="2" Maximum="20" Value="{Binding CurrentIris.LensRingCount}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8"
                                                IsEnabled="{Binding CurrentIris.LensPatternEnabled}"/>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="リング線色:" VerticalAlignment="Center" Width="110"/>
                                            <controls:ColorPickerBox AllowGradient="True" SelectedColorHex="{Binding CurrentIris.LensRingColor, Mode=TwoWay}"
                                                                    IsEnabled="{Binding CurrentIris.LensPatternEnabled}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="リング強度 (濃度):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.LensRingIntensity, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CurrentIris.LensRingIntensity}" Margin="0,0,0,8"
                                                IsEnabled="{Binding CurrentIris.LensPatternEnabled}"/>

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="リング線幅:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.LensRingWidth, StringFormat='{}{0:F1}'}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.3" Maximum="3.0" Value="{Binding CurrentIris.LensRingWidth}" Margin="0,0,0,8"
                                                IsEnabled="{Binding CurrentIris.LensPatternEnabled}"/>

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="中心屈折光 (コースティクス):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentIris.LensRefractionGlow, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CurrentIris.LensRefractionGlow}"
                                                IsEnabled="{Binding CurrentIris.LensPatternEnabled}"/>
                                    </StackPanel>
                                </GroupBox>

                                <!-- Odd-Eye Settings -->
                                <GroupBox Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10" Padding="8">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="オッドアイ設定・テンプレート" VerticalAlignment="Center"/>
                                            <CheckBox Content="🔒 ランダム生成で変えない" IsChecked="{Binding LockOddEye}" Style="{StaticResource RandomizeLockCheckBox}"
                                                      ToolTip="オッドアイのオン／オフ、反対側の目の色、模様のずらし量をランダム生成で変えない"/>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <StackPanel>
                                        <CheckBox Content="オッドアイ (左右異色瞳) を有効化" IsChecked="{Binding CurrentIris.IsOddEye}" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <TextBlock Text="左目と右目で異なる瞳色・シードを設定します (サイズ・形状・位置整合性は完全同期):" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                        <!-- Odd Eye Templates -->
                                        <TextBlock Text="オッドアイ・テンプレート選択:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding OddEyeTemplates}" SelectedItem="{Binding SelectedOddEyeTemplate}" DisplayMemberPath="Name" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedOddEyeTemplate.Description}" Foreground="#80D8FF" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                        <!-- Right Eye Custom Colors -->
                                        <TextBlock Text="右目専用カラーカスタマイズ:" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                        
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="右目ベース色:" VerticalAlignment="Center" Width="110"/>
                                            <controls:ColorPickerBox SelectedColorHex="{Binding CurrentIris.OddEyeBaseColor, Mode=TwoWay}"
                                                                    IsEnabled="{Binding CurrentIris.IsOddEye}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="右目内周色:" VerticalAlignment="Center" Width="110"/>
                                            <controls:ColorPickerBox SelectedColorHex="{Binding CurrentIris.OddEyeInnerColor, Mode=TwoWay}"
                                                                    IsEnabled="{Binding CurrentIris.IsOddEye}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="右目外周色:" VerticalAlignment="Center" Width="110"/>
                                            <controls:ColorPickerBox SelectedColorHex="{Binding CurrentIris.OddEyeOuterColor, Mode=TwoWay}"
                                                                    IsEnabled="{Binding CurrentIris.IsOddEye}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="右目ライン色:" VerticalAlignment="Center" Width="110"/>
                                            <controls:ColorPickerBox AllowGradient="True" SelectedColorHex="{Binding CurrentIris.OddEyeRayColor, Mode=TwoWay}"
                                                                    IsEnabled="{Binding CurrentIris.IsOddEye}"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="右目反射光色:" VerticalAlignment="Center" Width="110"/>
                                            <controls:ColorPickerBox SelectedColorHex="{Binding CurrentIris.OddEyeBottomHighlightColor, Mode=TwoWay}"
                                                                    IsEnabled="{Binding CurrentIris.IsOddEye}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ======================================================== -->
                    <!-- TAB 9 (下段): ハイライト & 左右対称 -->
                    <!-- ======================================================== -->
                    <TabItem Header="ハイライト・対称性" controls:TabRowsPanel.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                            <StackPanel>
                                <GroupBox Header="左右対称設定" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10" Padding="8">
                                    <StackPanel>
                                        <CheckBox Content="ハイライトも左右反転する (完全鏡像)"
                                                  IsChecked="{Binding CurrentIris.MirrorHighlightsWithIris}"
                                                  FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="※チェックを外すと、光源位置が固定された自然なライティングになります。" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,10" Padding="8">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ハイライト設定" VerticalAlignment="Center"/>
                                            <CheckBox Content="🔒 ランダム生成で変えない" IsChecked="{Binding LockHighlights}" Style="{StaticResource RandomizeLockCheckBox}"
                                                      ToolTip="ハイライトの一覧をランダム生成で変えない"/>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="ハイライト一覧:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Content="➕ ハイライト追加" Command="{Binding AddHighlightCommand}"
                                                    HorizontalAlignment="Right" Padding="8,4" Background="#1E3A5F" Foreground="#80D8FF" BorderBrush="{StaticResource BorderDark}"/>
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding CurrentIris.Highlights}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource BgLight}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,6">
                                                                <CheckBox Content="有効" IsChecked="{Binding Enabled}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                <Button Content="✕ 削除" Command="{Binding DataContext.RemoveHighlightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" HorizontalAlignment="Right" Padding="6,2" Background="#4A2020" Foreground="#FF8A80" BorderThickness="0" FontSize="11"/>
                                                            </DockPanel>

                                                            <TextBlock Text="形状:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2"/>
                                                            <WrapPanel Margin="0,0,0,6">
                                                                <RadioButton Content="正円" Margin="0,0,8,2" IsChecked="{Binding Shape, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Circle}"/>
                                                                <RadioButton Content="楕円" Margin="0,0,8,2" IsChecked="{Binding Shape, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Oval}"/>
                                                                <RadioButton Content="4点星" Margin="0,0,8,2" IsChecked="{Binding Shape, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Star4}"/>
                                                                <RadioButton Content="菱形" Margin="0,0,8,2" IsChecked="{Binding Shape, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Rhombus}"/>
                                                            </WrapPanel>

                                                            <DockPanel Margin="0,0,0,6">
                                                                <TextBlock Text="色:" VerticalAlignment="Center" Width="70"/>
                                                                <controls:ColorPickerBox AllowGradient="True" SelectedColorHex="{Binding Color, Mode=TwoWay}"/>
                                                            </DockPanel>

                                                            <DockPanel Margin="0,0,0,4">
                                                                <TextBlock Text="サイズ:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding Size, Converter={StaticResource DoubleToPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                                            </DockPanel>
                                                            <Slider Minimum="0.05" Maximum="0.45" Value="{Binding Size}" Margin="0,0,0,6"/>

                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="8"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="位置 X (横):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                                    <Slider Minimum="-0.85" Maximum="0.85" Value="{Binding PositionX}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="位置 Y (縦):" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                                    <Slider Minimum="-0.85" Maximum="0.85" Value="{Binding PositionY}"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <DockPanel Margin="0,0,0,4">
                                                                <TextBlock Text="楕円 縦横比:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding AspectRatio, StringFormat='{}{0:F2}'}" FontSize="11" HorizontalAlignment="Right"/>
                                                            </DockPanel>
                                                            <Slider Minimum="0.3" Maximum="2.5" Value="{Binding AspectRatio}" Margin="0,0,0,6"/>

                                                            <DockPanel Margin="0,0,0,4">
                                                                <TextBlock Text="回転角度:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding Rotation, StringFormat='{}{0:F0}°'}" FontSize="11" HorizontalAlignment="Right"/>
                                                            </DockPanel>
                                                            <Slider Minimum="-180" Maximum="180" Value="{Binding Rotation}" Margin="0,0,0,6"/>

                                                            <DockPanel Margin="0,0,0,4">
                                                                <TextBlock Text="透明度:" ToolTip="上げるほど透けます (0% で不透明、100% で見えない)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding Opacity, Converter={StaticResource TransparencyPercentConverter}}" FontSize="11" HorizontalAlignment="Right"/>
                                                            </DockPanel>
                                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding Opacity, Converter={StaticResource OpacityToTransparencyConverter}}"/>
                                                            <DockPanel Margin="0,6,0,0" ToolTip="このハイライトの重ね方。通常: そのまま重ねる。スクリーン: 明るくなるだけ (発光)。覆い焼き: 強い発光。オーバーレイ: 明るいところをより明るく、暗いところをより暗く。ソフトライト: オーバーレイの弱いもの">
                                                                <TextBlock Text="重ね方:" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Top" Margin="0,2,0,0" Width="70"/>
                                                                <WrapPanel>
                                                                    <RadioButton Content="通常" Margin="0,0,8,2" IsChecked="{Binding Blend, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Normal}"/>
                                                                    <RadioButton Content="スクリーン" Margin="0,0,8,2" IsChecked="{Binding Blend, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Screen}"/>
                                                                    <RadioButton Content="覆い焼き" Margin="0,0,8,2" IsChecked="{Binding Blend, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ColorDodge}"/>
                                                                    <RadioButton Content="オーバーレイ" Margin="0,0,8,2" IsChecked="{Binding Blend, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Overlay}"/>
                                                                    <RadioButton Content="ソフトライト" Margin="0,0,8,2" IsChecked="{Binding Blend, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=SoftLight}"/>
                                                                </WrapPanel>
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource BgMedium}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="{Binding CurrentIris.SizeMm, StringFormat='サイズ: {0:F1}mm | '}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentIris.Seed, StringFormat='シード: {0} | '}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    <TextBlock Text="{Binding ZoomScale, StringFormat='拡大率: {0:P0}'}" Foreground="#80D8FF" FontSize="11"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
